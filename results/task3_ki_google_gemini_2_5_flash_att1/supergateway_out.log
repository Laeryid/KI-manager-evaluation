r tool. Available tools: add_ki_to_config, create_adr, edit_doc_config, edit_know_file, git_checkpoint, git_restore, ki_finalize_scaffolds, ki_init_project, ki_migrate_project, ki_prune_registry, ki_register_project, ki_scaffold, ki_split, make_know_dir, restore_mapping, save_state, sync_agents_md, update_last_verified, write_know_file. Use ki_tools(name=...) to check arguments.", "inputSchema": {"type": "object", "properties": {"tool": {"type": "string", "description": "Name of the mutating tool to call.", "enum": ["add_ki_to_config", "create_adr", "edit_doc_config", "edit_know_file", "git_checkpoint", "git_restore", "ki_finalize_scaffolds", "ki_init_project", "ki_migrate_project", "ki_prune_registry", "ki_register_project", "ki_scaffold", "ki_split", "make_know_dir", "restore_mapping", "save_state", "sync_agents_md", "update_last_verified", "write_know_file"]}, "args": {"type": "object", "description": "Arguments dictionary to pass to the tool.", "default": {}}}, "required": ["tool"]}, "annotations": {"title": "Call Mutating Tool", "readOnlyHint": false, "destructiveHint": true, "idempotentHint": false}}], "ttlMs": 300000, "cacheScope": "global"}}
