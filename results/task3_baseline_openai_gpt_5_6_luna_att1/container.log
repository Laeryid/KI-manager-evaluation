ions, RenderResult\n\n\nclass Badge:\n    \"\"\"A small status badge that can be rendered by any Rich container.\n\n    Args:\n        text: The text displayed in the badge.\n        style: The style applied to the badge contents.\n        border_style: The style applied to the badge's delimiters and padding.\n        pill: Use rounded (parenthesis) delimiters when true, or square\n            delimiters when false.\n        icon: An optional icon displayed before ``text``.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _content(self) -> str:\n        \"\"\"Return the text displayed between the badge delimiters.\"\"\"\n        return self.text if self.icon is None else f\"{self.icon} {self.text}\"\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        \"\"\"Yield the badge as styled segments.\"\"\"\n        border_style = console.get_style(self.border_style)\n        content_style = console.get_style(self.style)\n        left, right = (\"( \", \" )\") if self.pill else (\"[ \", \" ]\")\n\n        yield Segment(left, border_style)\n        yield Segment(self._content, content_style)\n        yield Segment(right, border_style)\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        \"\"\"Return the exact number of terminal cells occupied by the badge.\"\"\"\n        width = cell_len(self._content) + 4\n        return Measurement(width, width)\n"}}],"api":"openai-completions","provider":"openrouter","model":"openai/gpt-5.6-luna","usage":{"input":3,"output":900,"cacheRead":10307,"cacheWrite":1625,"reasoning":332,"totalTokens":12835,"cost":{"input":6.000000000000001e-7,"output":0.00108,"cacheRead":0.00020614,"cacheWrite":0.00040625,"total":0.00169299,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794170036469,"responseId":"gen-1794170036-5lyyZRmu195x77gwe7kY","rawStopReason":"tool_calls","durationMs":9454,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call_XFkV0Ss1LPgRV90zuL6IQej3","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /app/rich/badge.py"}],"isError":false,"durationMs":9,"timestamp":1794170045937}]}
