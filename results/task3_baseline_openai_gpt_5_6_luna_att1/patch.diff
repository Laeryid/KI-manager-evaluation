+"""A compact, embeddable status badge renderable."""
+
+from typing import TYPE_CHECKING, Optional
+
+from .cells import cell_len
+from .measure import Measurement
+from .segment import Segment
+from .style import StyleType
+
+if TYPE_CHECKING:
+    from .console import Console, ConsoleOptions, RenderResult
+
+
+class Badge:
+    """A small status badge that can be rendered by any Rich container.
+
+    Args:
+        text: The text displayed in the badge.
+        style: The style applied to the badge contents.
+        border_style: The style applied to the badge's delimiters and padding.
+        pill: Use rounded (parenthesis) delimiters when true, or square
+            delimiters when false.
+        icon: An optional icon displayed before ``text``.
+    """
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    @property
+    def _content(self) -> str:
+        """Return the text displayed between the badge delimiters."""
+        return self.text if self.icon is None else f"{self.icon} {self.text}"
+
+    def __rich_console__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> "RenderResult":
+        """Yield the badge as styled segments."""
+        border_style = console.get_style(self.border_style)
+        content_style = console.get_style(self.style)
+        left, right = ("( ", " )") if self.pill else ("[ ", " ]")
+
+        yield Segment(left, border_style)
+        yield Segment(self._content, content_style)
+        yield Segment(right, border_style)
+
+    def __rich_measure__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> Measurement:
+        """Return the exact number of terminal cells occupied by the badge."""
+        width = cell_len(self._content) + 4
+        return Measurement(width, width)