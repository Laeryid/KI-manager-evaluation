] = None,\n         underline2: Optional[bool] = None,\n+        double_underline: Optional[bool] = None,\n         frame: Optional[bool] = None,\n         encircle: Optional[bool] = None,\n         overline: Optional[bool] = None,\n@@ -157,6 +162,8 @@ class Style:\n \n         self._color = None if color is None else _make_color(color)\n         self._bgcolor = None if bgcolor is None else _make_color(bgcolor)\n+        if double_underline is not None:\n+            underline2 = double_underline\n         self._set_attributes = sum(\n             (\n                 bold is not None,\n@@ -286,6 +293,11 @@ class Style:\n     encircle = _Bit(11)\n     overline = _Bit(12)\n \n+    @property\n+    def double_underline(self) -> bool:\n+        \"\"\"Whether double underlining is enabled.\"\"\"\n+        return bool(self.underline2)\n+\n     @property\n     def link_id(self) -> str:\n         \"\"\"Get a link id, used in ansi code for links.\"\"\"\n@@ -589,7 +601,9 @@ class Style:\n             append(\"font-weight: bold\")\n         if self.italic:\n             append(\"font-style: italic\")\n-        if self.underline:\n+        if self.double_underline:\n+            append(\"text-decoration: underline double\")\n+        elif self.underline:\n             append(\"text-decoration: underline\")\n         if self.strike:\n             append(\"text-decoration: line-through\")\ndiff --git a/tests/test_console.py b/tests/test_console.py\nindex ef829873..761b1a5f 100644\n--- a/tests/test_console.py\n+++ b/tests/test_console.py\n@@ -531,6 +531,12 @@ def test_export_html_inline() -> None:\n EXPECTED_SVG = '<svg class=\"rich-terminal\" viewBox=\"0 0 1238 74.4\" xmlns=\"http://www.w3.org/2000/svg\">\\n    <!-- Generated with Rich https://www.textualize.io -->\\n    <style>\\n\\n    @font-face {\\n        font-family: \"Fira Code\";\\n        src: local(\"FiraCode-Regular\"),\\n                url(\"https://cdnjs.cloudflare.com/ajax/libs/firacode/6.2.0/woff2/FiraCode-Regular.