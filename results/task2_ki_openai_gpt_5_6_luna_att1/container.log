.py\nindex c18b6095..7c9290ee 100644\n--- a/rich/default_styles.py\n+++ b/rich/default_styles.py\n@@ -11,6 +11,7 @@ DEFAULT_STYLES: Dict[str, Style] = {\n         bold=False,\n         italic=False,\n         underline=False,\n+        underline2=False,\n         blink=False,\n         blink2=False,\n         reverse=False,\n@@ -25,6 +26,9 @@ DEFAULT_STYLES: Dict[str, Style] = {\n     \"italic\": Style(italic=True),\n     \"emphasize\": Style(italic=True),\n     \"underline\": Style(underline=True),\n+    \"double_underline\": Style(underline2=True),\n+    \"double-underline\": Style(underline2=True),\n+    \"du\": Style(underline2=True),\n     \"blink\": Style(blink=True),\n     \"blink2\": Style(blink2=True),\n     \"reverse\": Style(reverse=True),\ndiff --git a/rich/style.py b/rich/style.py\nindex 3806a8c4..4f483f7f 100644\n--- a/rich/style.py\n+++ b/rich/style.py\n@@ -57,6 +57,7 @@ class Style:\n         conceal (bool, optional): Enable concealed text. Defaults to None.\n         strike (bool, optional): Enable strikethrough text. Defaults to None.\n         underline2 (bool, optional): Enable doubly underlined text. Defaults to None.\n+        double_underline (bool, optional): Enable doubly underlined text. Defaults to None.\n         frame (bool, optional): Enable framed text. Defaults to None.\n         encircle (bool, optional): Enable encircled text. Defaults to None.\n         overline (bool, optional): Enable overlined text. Defaults to None.\n@@ -121,7 +122,10 @@ class Style:\n         \"strike\": \"strike\",\n         \"s\": \"strike\",\n         \"underline2\": \"underline2\",\n+        \"double_underline\": \"underline2\",\n+        \"double-underline\": \"underline2\",\n         \"uu\": \"underline2\",\n+        \"du\": \"underline2\",\n         \"frame\": \"frame\",\n         \"encircle\": \"encircle\",\n         \"overline\": \"overline\",\n@@ -143,6 +147,7 @@ class Style:\n         conceal: Optional[bool] = None,\n         strike: Optional[bool] 