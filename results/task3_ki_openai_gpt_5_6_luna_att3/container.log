aracters.\n        pill: Use rounded parentheses instead of square brackets.\n        icon: An optional icon displayed before the text.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        content = self.text if self.icon is None else f\"{self.icon} {self.text}\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n\n        badge = Text()\n        badge.append(left, self.border_style)\n        badge.append(\" \", self.style)\n        badge.append(content, self.style)\n        badge.append(\" \", self.style)\n        badge.append(right, self.border_style)\n        yield badge\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        content = self.text if self.icon is None else f\"{self.icon} {self.text}\"\n        width = cell_len(content) + 4\n        return Measurement(width, width)\n"}}],"api":"openai-completions","provider":"openrouter","model":"openai/gpt-5.6-luna","usage":{"input":3,"output":547,"cacheRead":16914,"cacheWrite":390,"reasoning":42,"totalTokens":17854,"cost":{"input":6.000000000000001e-7,"output":0.0006564,"cacheRead":0.00033828,"cacheWrite":0.0000975,"total":0.00109278,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794170587219,"responseId":"gen-1794170587-kE2aH1tG6LSk4bBGBTv1","rawStopReason":"tool_calls","durationMs":5630,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call_cbgNE3pIf1djtNuXDjAlch8M","toolName":"write","content":[{"type":"text","text":"Suc