self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    def __repr__(self) -> str:\n        return f\"Badge({self.text!r}, pill={self.pill!r}, icon={self.icon!r})\"\n\n    def _build_text(self) -> Text:\n        \"\"\"Build the badge as a Text object (borders, optional icon, and content).\"\"\"\n        content = f\"{self.icon} {self.text}\" if self.icon else self.text\n        left, right = (\"( \", \" )\") if self.pill else (\"[ \", \" ]\")\n        return Text.assemble(\n            (left, self.border_style),\n            (content, self.style),\n            (right, self.border_style),\n        )\n\n    def __rich_console__(\n        self, console: Console, options: ConsoleOptions\n    ) -> RenderResult:\n        yield self._build_text()\n\n    def __rich_measure__(\n        self, console: Console, options: ConsoleOptions\n    ) -> Measurement:\n        return self._build_text().__rich_measure__(console, options)\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    from .console import Console\n\n    c = Console()\n    c.print(Badge(\"Passing\", icon=\"✔\"))\n    c.print(Badge(\"Failing\", pill=False, style=\"bold white on red\", border_style=\"red\"))\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":1013,"cacheRead":9841,"cacheWrite":1867,"totalTokens":12723,"cost":{"input":2.0000000000000002e-7,"output":0.0005065,"cacheRead":0.00009841,"cacheWrite":0.000233375,"total":0.000838485,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":37},"stopReason":"toolUse","timestamp":1794167761689,"providerThinkingLevel":"medium","responseId":"msg_011Cgr3ppRrPiH6XxoutB4BF","rawStopReason