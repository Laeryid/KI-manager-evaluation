nt} \", style=self.style)\n\n        if self.pill:\n            left_border = Text(\"(\", style=self.border_style)\n            right_border = Text(\")\", style=self.border_style)\n        else:\n            left_border = Text(\"[\", style=self.border_style)\n            right_border = Text(\"]\", style=self.border_style)\n\n        yield left_border\n        yield styled_text\n        yield right_border\n\n    def __rich_measure__(self, console: Console, options: ConsoleOptions) -> Measurement:\n        \"\"\"Measure the badge's width.\"\"\"\n        text_content = f\"{self.icon} {self.text}\" if self.icon else self.text\n        # +4 for the two border characters and two internal spaces\n        width = console.measure(Text(text_content)).maximum + 4\n        return Measurement(width, width)\n"}}}}
