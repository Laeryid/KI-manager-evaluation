diff --git a/tests/test_table.py b/tests/test_table.py
index 77a75338..08ad7e43 100644
--- a/tests/test_table.py
+++ b/tests/test_table.py
@@ -410,3 +410,26 @@ if __name__ == "__main__":
     render = render_tables()
     print(render)
     print(repr(render))
+
+
+def test_flexible_column_keeps_minimum_width_when_constrained():
+    console = Console(width=30, record=True)
+    table = Table(expand=True)
+    table.add_column("Service", width=22)
+    table.add_column("Host", width=18)
+    table.add_column("Load", ratio=1)
+    table.add_row("Database Primary", "db-node-01.internal", "82%")
+    console.print(table)
+    # The flexible column must still be visible rather than collapsing to '||'
+    rendered = console.export_text()
+    assert "||" not in rendered
+    assert "…" in rendered
+
+
+def test_expand_empty_table_with_zero_ratios_does_not_crash():
+    console = Console(width=40, file=io.StringIO())
+    table = Table(expand=True)
+    table.add_column("a", ratio=0)
+    table.add_column("b", ratio=0)
+    console.print(table)
+    console.print(Table(expand=True))
