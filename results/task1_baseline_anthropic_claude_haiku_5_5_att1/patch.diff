     assert ratio_distribute(10, [1, 0]) == [10, 0]
+
+
+def test_ratio_distribute_edge_cases():
+    # Negative or zero space never crashes; minimums are still honoured
+    assert ratio_distribute(-5, [1, 1]) == [0, 0]
+    assert ratio_distribute(-5, [1, 1], [3, 3]) == [3, 3]
+    # All-zero ratios fall back to an even split instead of asserting
+    assert ratio_distribute(10, [0, 0]) == [5, 5]
+    assert ratio_distribute(10, []) == []