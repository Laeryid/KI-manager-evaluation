@@ -217,3 +217,14 @@ def test_render_meta():
 
     text = render("foo[@click=(1, 2, 3)]bar[/]baz")
     assert text.get_style_at_offset(console, 3).meta == {"@click": (1, 2, 3)}
+
+
+def test_double_underline_markup() -> None:
+    from rich.console import Console
+    import io
+
+    console = Console(file=io.StringIO(), force_terminal=True, color_system="truecolor")
+    with console.capture() as capture:
+        console.print("[double_underline]Sample[/] [double-underline red]Alert[/]")
+    assert "\x1b[21mSample" in capture.get()
+    assert "\x1b[21;31mAlert" in capture.get()
diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..a2bbc9ca 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,18 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+def test_double_underline() -> None:
+    style = Style(double_underline=True)
+    assert style.double_underline
+    assert style.underline2
+    assert Style(double_underline=True) == Style(underline2=True)
+    for name in ("double_underline", "double-underline", "du"):
+        assert Style.parse(name).double_underline
+        assert Style.parse(f"not {name}").double_underline is False
+    assert (Style(bold=True) + Style(double_underline=True)).double_underline
+    assert Style.combine(
+        [Style(italic=True), Style(double_underline=True)]
+    ).double_underline
+    assert "text-decoration: underline double" in Style(double_underline=True).get_html_style()