diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..b6730901 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,18 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+def test_double_underline():
+    style = Style(double_underline=True)
+    assert style.double_underline is True
+    assert Style(double_underline=False).double_underline is False
+    assert Style().double_underline is None
+    assert Style.parse("double_underline").double_underline is True
+    assert Style.parse("double-underline").double_underline is True
+    assert Style.parse("du").double_underline is True
+    assert Style.parse("not du").double_underline is False
+    assert (Style(bold=True) + style).double_underline is True
+    assert Style.combine([Style(bold=True), style]).double_underline is True
+    assert style._make_ansi_codes(ColorSystem.TRUECOLOR) == "21"
+    assert style.get_html_style() == "text-decoration: underline double"