est_double_underline():\n    style = Style(double_underline=True)\n    assert style.double_underline is True\n    assert Style(double_underline=False).double_underline is False\n    assert Style().double_underline is None\n    assert Style.parse(\"double_underline\").double_underline is True\n    assert Style.parse(\"double-underline\").double_underline is True\n    assert Style.parse(\"du\").double_underline is True\n    assert Style.parse(\"not du\").double_underline is False\n    assert (Style(bold=True) + style).double_underline is True\n    assert Style.combine([Style(bold=True), style]).double_underline is True\n    assert style._make_ansi_codes(ColorSystem.TRUECOLOR) == \"21\"\n    assert style.get_html_style() == \"text-decoration: underline double\"\nEOF\npython3 -m pytest tests/test_style.py tests/test_markup.py tests/test_console.py -q 2>&1 | tail -1; python3 -m pytest tests -q 2>&1 | tail -1"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":803,"cacheRead":30354,"cacheWrite":483,"totalTokens":31642,"cost":{"input":2.0000000000000002e-7,"output":0.0004015,"cacheRead":0.00030354,"cacheWrite":0.000060375,"total":0.000765615,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":343},"stopReason":"toolUse","timestamp":1794167709272,"providerThinkingLevel":"medium","responseId":"msg_011Cgr3kwnWnS7uVvCTTqxVx","rawStopReason":"tool_use","durationMs":3949,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"toolu_01DqAYJaR1UyejtUgH2VH8Ts","toolName":"bash","content":[{"type":"text","text":"148 passed in 1.06s\n12 failed, 940 passed, 26 skipped, 1 warning in 6.68s\n"}],"isError":false,"durationMs":8330,"timestamp":1794167721555},{"role":"assistant","content":[{"type":"text","text":"`double_underline` is now a first-class style attribute, and the new behavior works in parsing, combining, markup, ANSI output, HTML, and SVG.\n\n**Changes**\n\n- **`rich/style.py`**\n  - `Style.__init__` accepts `double_underline`.\n  - Added a `double_underline` property.\n  - `double_underline`, `double-underline`, and `du` are registered in `STYLE_ATTRIBUTES`, so they parse in styles and markup (including `not du`).\n  - `get_html_style()` emits `text-decoration: underline double`.\n- **`rich/console.py`**: `export_svg()` emits `text-decoration: underline double;`.\n- **`tests/test_style.py`**: added `test_double_underline`.\n\n**Design choice:** the codebase already had `underline2`, which uses SGR 21, the same code as a double underline. Rather than add a second bit, `double_underline` is an alias for that bit. This means `Style(double_underline=True).underline2` is also `True`, and the two keywords are interchangeable. It is consistent with ADR-0003, which lists `double_underline` as a sibling of `underline`.\n\n**Verified**\n\n- `[double_underline]Sample[/]` and `[double-underline red]Alert[/]` render with `\\x1b[21m` and `\\x1b[21;31m`.\n- `style1 + style2` and `Style.combine()` preserve the attribute.\n- HTML export (both stylesheet and inline modes) and SVG export contain the double-underline rule.\n\n**Behavior change:** `underline2=True` previously produced no CSS in HTML/SVG exports. It now produces the double-underline rule, since it is the same attribute. In HTML and SVG, `double_underline` takes precedence over `underline` if both are set.\n\n**Test results:** the full suite has 12 failures, the same 12 that fail on the untouched repo (card, markdown, and syntax rendering tests), so there are no regressions. I didn't investigate those 12 failures."}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":662,"cacheRead":30837,"cacheWrite":849,"totalTokens":32350,"cost":{"input":2.0000000000000002e-7,"output":0.00033099999999999997,"cacheRead":0.00030837000000000003,"cacheWrite":0.000106125,"total":0.000745695,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":0},"stopReason":"stop","timest