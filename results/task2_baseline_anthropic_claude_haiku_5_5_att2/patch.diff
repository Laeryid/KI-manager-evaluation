diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..edc1e2a3 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -1,6 +1,9 @@
+import io
+
 import pytest
 
 from rich import errors
+from rich.console import Console
 from rich.color import Color, ColorSystem, ColorType
 from rich.style import Style, StyleStack
 
@@ -265,3 +268,26 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+
+def test_double_underline():
+    style = Style(double_underline=True)
+    assert style.double_underline
+    assert style.underline2
+    assert Style.parse("double_underline").double_underline
+    assert Style.parse("double-underline").double_underline
+    assert Style.parse("du").double_underline
+    assert not Style.parse("not du").double_underline
+    assert (Style(bold=True) + Style(double_underline=True)).double_underline
+    assert Style.combine(
+        [Style(bold=True), Style(double_underline=True)]
+    ).double_underline
+    assert style.get_html_style() == "text-decoration: underline double"
+    assert style._make_ansi_codes(ColorSystem.TRUECOLOR) == "21"
+
+
+def test_double_underline_svg_export():
+    console = Console(record=True, width=40, file=io.StringIO())
+    console.print("[double_underline]Sample[/]")
+    assert "text-decoration: underline double;" in console.export_svg()