4JGEQmLHl8A=.eyJlbmRwb2ludF9zbHVnIjoib3BlbmFpL2dwdC01LjYtbHVuYS0yMDI2MDcwOXxvcGVuYWkifQ\",\"format\":\"openai-responses-v1\",\"id\":\"rs_07faefc534b8fdcd016af0ddf988c487d1b13ffdfe301f5f81\",\"index\":0}]"},{"type":"toolCall","id":"call_Qxysh6dy9YKTsB6oOlCUkr53","name":"write","arguments":{"path":"rich/badge.py","content":"\"\"\"A compact status badge renderable.\"\"\"\n\nfrom typing import TYPE_CHECKING, Optional\n\nfrom .cells import cell_len\nfrom .measure import Measurement\nfrom .segment import Segment\nfrom .style import StyleType\n\nif TYPE_CHECKING:\n    from .console import Console, ConsoleOptions, RenderResult\n\n\nclass Badge:\n    \"\"\"A styled, embeddable status badge.\n\n    Args:\n        text: The text displayed by the badge.\n        style: The style applied to the badge content and its padding.\n        border_style: The style applied to the badge boundary characters.\n        pill: Use rounded ``( )`` boundaries when true, or square ``[ ]``\n            boundaries when false.\n        icon: An optional icon displayed before the text.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def content(self) -> str:\n        \"\"\"Return the text and optional icon displayed inside the badge.\"\"\"\n        return f\"{self.icon} {self.text}\" if self.icon is not None else self.text\n\n    @property\n    def _plain(self) -> str:\n        \"\"\"Return the complete plain-text representation of the badge.\"\"\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        return f\"{left} {self.content} {right}\"\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        \"\"\"Render the badge as independently styled terminal segments.\"\"\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        border_style = console.get_style(self.border_style)\n        content_style = console.get_style(self.style)\n\n        yield Segment(left, border_style)\n        yield Segment(f\" {self.content} \", content_style)\n        yield Segment(right, border_style)\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        \"\"\"Return the exact cell width required by the badge.\"\"\"\n        width = cell_len(self._plain)\n        return Measurement(width, width)\n"}}],"api":"openai-completions","provider":"openrouter","model":"openai/gpt-5.6-luna","usage":{"input":3,"output":976,"cacheRead":18164,"cacheWrite":187,"reasoning":344,"totalTokens":19330,"cost":{"input":6.000000000000001e-7,"output":0.0011711999999999998,"cacheRead":0.00036328,"cacheWrite":0.00004675,"total":0.00158183,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794170360408,"responseId":"gen-1794170360-M5wHdwawK24p7FOxtc3D","rawStopReason":"tool_calls","durationMs":10245,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call_Qxysh6dy9YKTsB6oOlCUkr53","toolName":"write","content":[{"type":"text","text":"Successfully wrote to rich/badge.py"}],"isError":false,"durationMs":7,"timestamp":1794170370664},{"role":"assistant","content":[{"type":"thinking","thinking":"","thinkingSignature":"[{\"type\":\"reasoning.encrypted\",\"data\":\"gAAAAABq8N4Eh68egWj9nP6TVPY9SZ0beSPd0ocOsqgkAukwxSOi93x-FrW56RUNvhqdqEqOcKVHMHsZPRekcvage7USU-HuJ3LNRcmCgGnmCSOxkxQ7bMBBCTOiRrFBQerFutWd8W2dXkmrQNVdg3-la2AIREe6mM7kcx1vgkdqm79Xn5VlN5jTP-wOnm79Vm3V3CyIK7Aqc8n-aD8v1qrU9t3Q8FvRk2Cp_3baPCrZePXsG_vlrkKJKyXbQl53-l_FC9Jfb8bKv_Gc5ZuKkkPWVP80Tou0tkG8zD0chuRlyjIcr_ZY5DxMPYaS3iQA2eqwcLy_WskZbWs9Z6bf8zLuBRcOEOnLqphdpYtTiWOY2xAIt4jFPi_dQ