,"cost":{"input":6.000000000000001e-7,"output":0.00046679999999999996,"cacheRead":0.00096876,"cacheWrite":0.0001565,"total":0.00159266,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794170403917,"responseId":"gen-1794170404-meNIlJPaZu9lquxs1q3t","rawStopReason":"tool_calls","durationMs":5604,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"call_kg646DkopMBJnJ93TWtTENxn","toolName":"bash","content":[{"type":"text","text":"diff --git a/rich/__init__.py b/rich/__init__.py\nindex 3edd12e0..3ee8fdf4 100644\n--- a/rich/__init__.py\n+++ b/rich/__init__.py\n@@ -4,8 +4,16 @@ import os\n from typing import IO, TYPE_CHECKING, Any, Callable, Optional, Union\n \n from ._extension import load_ipython_extension  # noqa: F401\n-\n-__all__ = [\"get_console\", \"reconfigure\", \"print\", \"inspect\", \"print_json\"]\n+from .badge import Badge\n+\n+__all__ = [\n+    \"Badge\",\n+    \"get_console\",\n+    \"reconfigure\",\n+    \"print\",\n+    \"inspect\",\n+    \"print_json\",\n+]\n \n if TYPE_CHECKING:\n     from .console import Console\ndiff --git a/rich/badge.py b/rich/badge.py\nnew file mode 100755\nindex 00000000..c97782ce\n--- /dev/null\n+++ b/rich/badge.py\n@@ -0,0 +1,69 @@\n+\"\"\"A compact status badge renderable.\"\"\"\n+\n+from typing import TYPE_CHECKING, Optional\n+\n+from .cells import cell_len\n+from .measure import Measurement\n+from .segment import Segment\n+from .style import StyleType\n+\n+if TYPE_CHECKING:\n+    from .console import Console, ConsoleOptions, RenderResult\n+\n+\n+class Badge:\n+    \"\"\"A styled, embeddable status badge.\n+\n+    Args:\n+        text: The text displayed by the badge.\n+        style: The style applied to the badge content and its padding.\n+        border_style: The style applied to the badge boundary characters.\n+        pill: Use rounded ``( )`` boundaries when true, or square ``[ ]``\n+            boundaries when false.\n+        icon: An optional icon displayed before the text.\n+    \"\"\"\n+\n+    def __init__(\n+        self,\n+        text: str,\n+        *,\n+        style: StyleType = \"bold white on blue\",\n+        border_style: StyleType = \"blue\",\n+        pill: bool = True,\n+        icon: Optional[str] = None,\n+    ) -> None:\n+        self.text = text\n+        self.style = style\n+        self.border_style = border_style\n+        self.pill = pill\n+        self.icon = icon\n+\n+    @property\n+    def content(self) -> str:\n+        \"\"\"Return the text and optional icon displayed inside the badge.\"\"\"\n+        return f\"{self.icon} {self.text}\" if self.icon is not None else self.text\n+\n+    @property\n+    def _plain(self) -> str:\n+        \"\"\"Return the complete plain-text representation of the badge.\"\"\"\n+        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n+        return f\"{left} {self.content} {right}\"\n+\n+    def __rich_console__(\n+        self, console: \"Console\", options: \"ConsoleOptions\"\n+    ) -> \"RenderResult\":\n+        \"\"\"Render the badge as independently styled terminal segments.\"\"\"\n+        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n+        border_style = console.get_style(self.border_style)\n+        content_style = console.get_style(self.style)\n+\n+        yield Segment(left, border_style)\n+        yield Segment(f\" {self.content} \", content_style)\n+        yield Segment(right, border_style)\n+\n+    def __rich_measure__(\n+        self, console: \"Console\", options: \"ConsoleOptions\"\n+    ) -> Measurement:\n+        \"\"\"Return the exact cell width required by the badge.\"\"\"\n+        width = cell_len(self._plain)\n+        return Measurement(width, width)\n"}],"isError":false,"durationMs":181,"timestamp":1794170410507},{"role":"toolResult","toolCallId":"call_2LwJcJtafwQz9QHD4MyVwGHB","toolName":"bash","content":[{"type":"text","text":"..................................                                       [100%]\n============================