{"type":"message_update","usage":{"input":2,"output":8,"cacheRead":18074,"cacheWrite":2161,"totalTokens":20245,"cost":{"input":2.0000000000000002e-7,"output":0.000004,"cacheRead":0.00018074,"cacheWrite":0.000270125,"total":0.00045506500000000005,"totalFromProvider":false},"cacheWrite1h":0},"assistantMessageEvent":{"type":"toolcall_end","contentIndex":2,"toolCall":{"type":"toolCall","id":"toolu_01V62U5fWMSCTQoSYWNLnkeW","name":"write","arguments":{"path":"/app/rich/badge.py","content":"from typing import TYPE_CHECKING, List, Optional\n\nfrom .cells import cell_len\nfrom .measure import Measurement\nfrom .segment import Segment\nfrom .style import Style, StyleType\n\nif TYPE_CHECKING:\n    from .console import Console, ConsoleOptions, RenderResult\n\n\nclass Badge:\n    \"\"\"A compact, single-line status badge.\n\n    Pill badges are wrapped in curved caps ``( `` and `` )``; square badges use\n    ``[ `` and `` ]``. The content is padded with one space on each side inside\n    the caps, following the repository's inline badge convention.\n\n    Args:\n        text (str): Text to display in the badge.\n        style (StyleType, optional): Style applied to the badge content. Defaults to \"bold white on blue\".\n        border_style (StyleType, optional): Style applied to the boundary caps. Defaults to \"blue\".\n        pill (bool, optional): Use curved pill caps if True, square caps if False. Defaults to True.\n        icon (str, optional): An optional icon rendered before the text. Defaults to None.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _content(self) -> str:\n        \"\"\"str: The text to display, including the icon if one is set.\"\"\"\n        if self.icon:\n            return f\"{self.icon} {self.text}\"\n        return self.text\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        content_style = console.get_style(self.style)\n        border = console.get_style(self.border_style)\n        segments: List[Segment] = [\n            Segment(f\"{left} \", border),\n            Segment(self._content, content_style),\n            Segment(f\" {right}\", border),\n        ]\n        lines = Segment.split_and_crop_lines(\n            segments, options.max_width, pad=False\n        )\n        for line in lines:\n            yield from line\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        # Two caps plus one padding space on each side of the content.\n        width = cell_len(self._content) + 4\n        return Measurement(width, width).clamp(max_width=options.max_width)\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    from rich import print\n\n    print(Badge(\"DEPLOYED\", icon=\"★\"))\n    print(Badge(\"SYSTEM ALERT\", pill=False, style=\"bold white on red\", border_style=\"red\"))\n"}}}}
