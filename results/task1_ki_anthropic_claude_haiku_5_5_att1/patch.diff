+def test_flexible_column_keeps_minimum_width_when_constrained() -> None:
+    console = Console(width=40, record=True, file=io.StringIO(), color_system=None)
+    table = Table(expand=True)
+    table.add_column("Service", width=22)
+    table.add_column("Host", width=18)
+    table.add_column("Load", ratio=1)
+    table.add_row("Database Primary", "db-node-01.internal", "82%")
+    console.print(table)
+    lines = console.export_text().splitlines()
+    # Header row: the flexible "Load" column must have a visible (non-empty) cell.
+    header_cells = lines[1].split("┃")
+    assert len(header_cells) == 5
+    assert header_cells[3].strip() != ""
+    # The flexible column never collapses to a bare "||" border.
+    assert "││" not in lines[4]
+
+
+def test_nested_table_flexible_column_stays_visible() -> None:
+    console = Console(width=40, record=True, file=io.StringIO(), color_system=None)
+    inner = Table(expand=True)
+    inner.add_column("K", width=30)
+    inner.add_column("V", ratio=1)
+    inner.add_row("key", "value")
+    outer = Table(expand=True)
+    outer.add_column("x", width=20)
+    outer.add_column("y", ratio=1)
+    outer.add_row("a", inner)
+    console.print(outer)
+    assert "││" not in console.export_text()
+
+
+@pytest.mark.parametrize("width", [0, 1, 5, 20, 60])
+@pytest.mark.parametrize("ratio", [0, 1, None])
+def test_empty_and_zero_ratio_tables_do_not_crash(width: int, ratio: Optional[int]) -> None:
+    console = Console(width=width, file=io.StringIO(), color_system=None)
+    table = Table(expand=True)
+    table.add_column("A", ratio=ratio)
+    table.add_column("B", ratio=ratio)
+    console.print(table)
+    console.print(Table(expand=True))