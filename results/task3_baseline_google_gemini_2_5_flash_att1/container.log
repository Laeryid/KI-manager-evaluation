nsole(width=80, legacy_windows=False)\n    badge = Badge(\"Success\", style=\"bold white on green\", border_style=\"green\", pill=True, icon=\"✔\")\n    render_result = console.export_text(badge)\n    assert render_result == \"( ✔ Success )\"\n\ndef test_badge_render_square() -> None:\n    console = Console(width=80, legacy_windows=False)\n    badge = Badge(\"Failed\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"✘\")\n    render_result = console.export_text(badge)\n    assert render_result == \"[ ✘ Failed ]\"\n\ndef test_badge_render_no_icon() -> None:\n    console = Console(width=80, legacy_windows=False)\n    badge = Badge(\"Info\", style=\"bold black on cyan\", border_style=\"cyan\")\n    render_result = console.export_text(badge)\n    assert render_result == \"( Info )\"\n\ndef test_badge_measurement() -> None:\n    console = Console()\n    options = console.options\n\n    badge1 = Badge(\"Test\")\n    measurement1 = badge1.__rich_measure__(console, options)\n    assert measurement1 == Measurement(8, 8)  # \"( Test )\" has 8 characters\n\n    badge2 = Badge(\"Long Text\", icon=\"🌟\")\n    measurement2 = badge2.__rich_measure__(console, options)\n    assert measurement2 == Measurement(15, 15)  # \"( 🌟 Long Text )\" has 15 characters\n\ndef test_badge_in_table() -> None:\n    console = Console(width=80, legacy_windows=False)\n    table = Table(\"Status\", \"Description\")\n    table.add_row(Badge(\"New\", style=\"bold black on yellow\", border_style=\"yellow\"), \"A new item\")\n    render_result = console.export_text(table)\n    expected_lines = [\n        \"━━━━━━━ ━━━━━━━━━━━\",\n        \"( New ) A new item \",\n        \"━━━━━━━ ━━━━━━━━━━━\",\n    ]\n    assert render_result.strip().splitlines() == expected_lines\n\ndef test_badge_in_panel() -> None:\n    console = Console(width=80, legacy_windows=False)\n    panel = Panel(Badge(\"Alert\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"🚨\"), title=\"System Alert\")\n    render_result = console.export_text(panel)\n    expected_lines = [\n        \"╭──────────────────╮\",\n        \"│   System Alert   │\",\n        \"├──────────────────┤\",\n        \"│ [ 🚨 Alert ]     │\",\n        \"╰──────────────────╯\",\n    ]\n    assert render_result.strip().splitlines() == expected_lines"}}],"api":"openai-completions","provider":"openrouter","model":"google/gemini-2.5-flash","usage":{"input":541,"output":837,"cacheRead":105187,"cacheWrite":0,"reasoning":0,"totalTokens":106565,"cost":{"input":0.0001623,"output":0.0020925,"cacheRead":0.0031556099999999997,"cacheWrite":0,"total":0.00541041,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794172122940,"responseId":"gen-1794172123-sQjOiIJ7bozeuGkQ76HU","rawStopReason":"tool_calls","durationMs":5190,"thinkingLevel":"off"},{"role":"toolResult","toolCallId":"tool_write_PMoZzPFC2hShtpIOGff2","toolName":"write","content":[{"type":"text","text":"Successfully wrote to tests/test_badge.py"}],"isError":false,"durationMs":32,"timestamp":1794172128237},{"role":"assistant","content":[{"type":"text","text":"Now I will run the newly created test file `tests/test_badge.py` to verify the `Badge` component.\n\n"},{"type":"toolCall","id":"tool_bash_6c4sx33MEz3ZrxWcivMN","name":"bash","arguments":{"command":"pytest tests/test_badge.py -q"}}],"api":"openai-completions","provider":"openrouter","model":"google/gemini-2.5-flash","usage":{"input":1411,"output":48,"cacheRead":105177,"cacheWrite":0,"reasoning":0,"totalTokens":106636,"cost":{"input":0.0004233,"output":0.00012000000000000002,"cacheRead":0.0031553099999999997,"cacheWrite":0,"total":0.00369861,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794172128284,"responseId":"gen-1794172128-jDAGeV2kCDYIELtyoSRH","rawStopReason":"tool_calls","durationMs":1665,"thinkingLevel":"off"},{"role":"toolResult","toolCallId":"tool_bash_6c4sx33MEz3ZrxWcivMN","toolName":"bash","content":[{"type":"text","text":"\n==============================