{"type":"message_update","usage":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"totalTokens":0,"cost":{"input":0,"output":0,"cacheRead":0,"cacheWrite":0,"total":0}},"assistantMessageEvent":{"type":"toolcall_delta","contentIndex":1,"delta":"{\"edits\":[{\"oldText\":\"from typing import Optional\\n\\nfrom .console import Console, ConsoleOptions, RenderResult, Segment, Segments\\nfrom .style import StyleType, Style\\nfrom .measure import Measurement\\nfrom .text import Text\\n\\nclass Badge:\\n    \\\"\\\"\\\"A simple UI badge.\\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        text: str,\\n        *,\\n        style: StyleType = \\\"bold white on blue\\\",\\n        border_style: StyleType = \\\"blue\\\",\\n        pill: bool = True,\\n        icon: Optional[str] = None,\\n    ) -> None:\\n        self.text = text\\n        self.style = style\\n        self.border_style = border_style\\n        self.pill = pill\\n        self.icon = icon\\n\\n    def __rich_console__(self, console: Console, options: ConsoleOptions) -> RenderResult:\\n        \\\"\\\"\\\"Render the badge to the console.\\\"\\\"\\\"\\n        text = Text(self.text, style=self.style)\\n        if self.icon:\\n            text = Text(f\\\"{self.icon} \\\", style=self.style) + text\\n\\n        style = console.get_style(self.style)\\n        border_style = console.get_style(self.border_style)\\n\\n        if self.pill:\\n            left_border = Text(\\\"( \\\", style=border_style)\\n            right_border = Text(\\\" )\\\", style=border_style)\\n        else:\\n            left_border = Text(\\\"[ \\\", style=border_style)\\n            right_border = Text(\\\" ]\\\", style=border_style)\\n        \\n        yield left_border.render(console)\\n        yield text.render(console)\\n        yield right_border.render(console)\\n\\n    def __rich_measure__(self, console: \\\"Console\\\", options: \\\"ConsoleOptions\\\") -> \\\"Measurement\\\":\\n        \\\"\\\"\\\"Measure the badge for layout.\\\"\\\"\\\"\\n        text = Text(self.text)\\n        if self.icon:\\n            text = Text(f\\\"{self.icon} \\\") + text\\n        \\n        # Account for borders: \\\"( \\\" + \\\" )\\\" or \\\"[ \\\" + \\\" ]\\\"\\n        width = text.cell_len + 4 \\n        return Measurement(width, width)\",\"newText\":\"from typing import Optional, TYPE_CHECKING\\n\\nif TYPE_CHECKING:\\n    from .console import Console, ConsoleOptions, RenderResult, Segment\\n    from .measure import Measurement\\n\\nfrom .style import StyleType, Style\\nfrom .text import Text\\n\\n\\nclass Badge:\\n    \\\"\\\"\\\"A simple UI badge.\\\"\\\"\\\"\\n\\n    def __init__(\\n        self,\\n        text: str,\\n        *,\\n        style: StyleType = \\\"bold white on blue\\\",\\n        border_style: StyleType = \\\"blue\\\",\\n        pill: bool = True,\\n        icon: Optional[str] = None,\\n    ) -> None:\\n        self.text = text\\n        self.style = style\\n        self.border_style = border_style\\n        self.pill = pill\\n        self.icon = icon\\n\\n    def __rich_console__(self, console: \\\"Console\\\", options: \\\"ConsoleOptions\\\") -> \\\"RenderResult\\\":\\n        \\\"\\\"\\\"Render the badge to the console.\\\"\\\"\\\"\\n        text = Text(self.text, style=self.style)\\n        if self.icon:\\n            text = Text(f\\\"{self.icon} \\\", style=self.style) + text\\n\\n        style = console.get_style(self.style)\\n        border_style = console.get_style(self.border_style)\\n\\n        if self.pill:\\n            left_border = Text(\\\"( \\\", style=border_style)\\n            right_border = Text(\\\" )\\\", style=border_style)\\n        else:\\n            left_border = Text(\\\"[ \\\", style=border_style)\\n            right_border = Text(\\\" ]\\\", style=border_style)\\n        \\n        yield from left_border.render(console)\\n        yield from text.render(console)\\n        yield from right_border.render(console)\\n\\n    def __rich_measure__(self, console: \\\"Console\\\", options: \\\"ConsoleOptions\\\") -> \\\"Measurement\\\":\\n        \\\"\\\"\\\"Measure the badge for layout.\\\"\\\"\\\"\\n        from .measure import Measurement\\n        text = Text(self.text)\\n        if self.icon:\\n            text = Text(f\\\"{self.icon} \\\") + text\\n        \\n        # Account for borders: \\\"( \\\" + \\\" )\\\" or \\\"[ \\\" + \\\" ]\\\"\\n        width = text.cell_len + 4 \\n        return Measurement(width, width)\"}],\"path\":\"rich/badge.py\"}"}}
