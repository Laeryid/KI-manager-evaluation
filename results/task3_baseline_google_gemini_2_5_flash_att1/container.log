{"type":"tool_execution_end","toolCallId":"tool_read_0trPfGFZrcJHkj5SqpL4","toolName":"read","result":{"content":[{"type":"text","text":"from rich.console import Console\nfrom rich.table import Table\nfrom rich.panel import Panel\nfrom rich.text import Text\nfrom rich.measure import Measurement\nfrom rich.style import Style\nfrom rich.badge import Badge\n\ndef test_badge_render_pill() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Success\", style=\"bold white on green\", border_style=\"green\", pill=True, icon=\"✔\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"( ✔ Success )\\n\"\n    assert render_result == \"( ✔ Success )\\n\"\n\ndef test_badge_render_square() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Failed\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"✘\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"[ ✘ Failed ]\\n\"\n    assert render_result == \"[ ✘ Failed ]\\n\"\n\ndef test_badge_render_no_icon() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Info\", style=\"bold black on cyan\", border_style=\"cyan\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"( Info )\\n\"\n    assert render_result == \"( Info )\\n\"\n\ndef test_badge_measurement() -> None:\n    console = Console()\n    options = console.options\n\n    badge1 = Badge(\"Test\")\n    measurement1 = badge1.__rich_measure__(console, options)\n    assert measurement1 == Measurement(8, 8)  # \"( Test )\" has 8 characters\n\n    badge2 = Badge(\"Long Text\", icon=\"🌟\")\n    measurement2 = badge2.__rich_measure__(console, options)\n    assert measurement2 == Measurement(16, 16)  # \"( 🌟 Long Text )\" has 16 characters (icon is 2 cells)\n\ndef test_badge_in_table() -> None:\n    console = Console(width=25, height=5, legacy_windows=False, record=True)\n    table = Table(\"Status\", \"Description\")\n    table.add_row(Badge(\"New\", style=\"bold black on yellow\", border_style=\"yellow\"), \"A new item\")\n    console.print(table)\n    render_result = console.export_text()\n    expected_lines = \"\"\"\n┏━━━━━━━━━┳━━━━━━━━━━━━━┓\n┃ Status  ┃ Description ┃\n┡━━━━━━━━━╇━━━━━━━━━━━━━┩\n│ ( New ) │ A new item  │\n└─────────┴─────────────┘\n\"\"\".strip().splitlines()\n    assert render_result.strip().splitlines() == expected_lines\n\ndef test_badge_in_panel() -> None:\n    console = Console(width=80, height=5, legacy_windows=False, record=True)\n    panel = Panel(Badge(\"Alert\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"🚨\"), title=\"System Alert\")\n    console.print(panel)\n    render_result = console.export_text()\n    expected_lines = \"\"\"\n╭──────────────────────────────── System Alert ────────────────────────────────╮\n│ [ 🚨 Alert ]                                                                 │\n╰──────────────────────────────────────────────────────────────────────────────╯\n\"\"\".strip().splitlines()\n    assert render_result.strip().splitlines() == expected_lines"}],"structuredContent":"from rich.console import Console\nfrom rich.table import Table\nfrom rich.panel import Panel\nfrom rich.text import Text\nfrom rich.measure import Measurement\nfrom rich.style import Style\nfrom rich.badge import Badge\n\ndef test_badge_render_pill() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Success\", style=\"bold white on green\", border_style=\"green\", pill=True, icon=\"✔\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"( ✔ Success )\\n\"\n    assert render_result == \"( ✔ Success )\\n\"\n\ndef test_badge_render_square() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Failed\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"✘\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"[ ✘ Failed ]\\n\"\n    assert render_result == \"[ ✘ Failed ]\\n\"\n\ndef test_badge_render_no_icon() -> None:\n    console = Console(width=80, legacy_windows=False, record=True)\n    badge = Badge(\"Info\", style=\"bold black on cyan\", border_style=\"cyan\")\n    console.print(badge)\n    render_result = console.export_text()\n    assert render_result == \"( Info )\\n\"\n    assert render_result == \"( Info )\\n\"\n\ndef test_badge_measurement() -> None:\n    console = Console()\n    options = console.options\n\n    badge1 = Badge(\"Test\")\n    measurement1 = badge1.__rich_measure__(console, options)\n    assert measurement1 == Measurement(8, 8)  # \"( Test )\" has 8 characters\n\n    badge2 = Badge(\"Long Text\", icon=\"🌟\")\n    measurement2 = badge2.__rich_measure__(console, options)\n    assert measurement2 == Measurement(16, 16)  # \"( 🌟 Long Text )\" has 16 characters (icon is 2 cells)\n\ndef test_badge_in_table() -> None:\n    console = Console(width=25, height=5, legacy_windows=False, record=True)\n    table = Table(\"Status\", \"Description\")\n    table.add_row(Badge(\"New\", style=\"bold black on yellow\", border_style=\"yellow\"), \"A new item\")\n    console.print(table)\n    render_result = console.export_text()\n    expected_lines = \"\"\"\n┏━━━━━━━━━┳━━━━━━━━━━━━━┓\n┃ Status  ┃ Description ┃\n┡━━━━━━━━━╇━━━━━━━━━━━━━┩\n│ ( New ) │ A new item  │\n└─────────┴─────────────┘\n\"\"\".strip().splitlines()\n    assert render_result.strip().splitlines() == expected_lines\n\ndef test_badge_in_panel() -> None:\n    console = Console(width=80, height=5, legacy_windows=False, record=True)\n    panel = Panel(Badge(\"Alert\", style=\"bold white on red\", border_style=\"red\", pill=False, icon=\"🚨\"), title=\"System Alert\")\n    console.print(panel)\n    render_result = console.export_text()\n    expected_lines = \"\"\"\n╭──────────────────────────────── System Alert ────────────────────────────────╮\n│ [ 🚨 Alert ]                                                                 │\n╰──────────────────────────────────────────────────────────────────────────────╯\n\"\"\".strip().splitlines()\n    assert render_result.strip().splitlines() == expected_lines"},"isError":false,"durationMs":6}
