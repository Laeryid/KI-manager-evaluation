diff --git a/rich/badge.py b/rich/badge.py
new file mode 100644
index 00000000..0756b037
--- /dev/null
+++ b/rich/badge.py
@@ -0,0 +1,58 @@
+from typing import Optional, TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .console import Console, ConsoleOptions, RenderResult, Segment
+    from .measure import Measurement
+
+from .style import StyleType, Style
+from .text import Text
+
+
+class Badge:
+    """A simple UI badge."""
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    def __rich_console__(self, console: "Console", options: "ConsoleOptions") -> "RenderResult":
+        """Render the badge to the console."""
+        text = Text(self.text, style=self.style)
+        if self.icon:
+            text = Text(f"{self.icon} ", style=self.style) + text
+
+        style = console.get_style(self.style)
+        border_style = console.get_style(self.border_style)
+
+        if self.pill:
+            left_border = Text("( ", style=border_style)
+            right_border = Text(" )", style=border_style)
+        else:
+            left_border = Text("[ ", style=border_style)
+            right_border = Text(" ]", style=border_style)
+        
+        yield from left_border.render(console)
+        yield from text.render(console)
+        yield from right_border.render(console)
+
+    def __rich_measure__(self, console: "Console", options: "ConsoleOptions") -> "Measurement":
+        """Measure the badge for layout."""
+        from .measure import Measurement
+        text = Text(self.text)
+        if self.icon:
+            text = Text(f"{self.icon} ") + text
+        
+        # Account for borders: "( " + " )" or "[ " + " ]"
+        width = text.cell_len + 4 
+        return Measurement(width, width)
