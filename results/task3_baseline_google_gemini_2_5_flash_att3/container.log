me=\"monokai\",\n            code_width=60,\n            word_wrap=False,\n        )\n        return render(syntax)\n    elif test_name == \"test_python_render_indent_guides\":\n        syntax = Panel.fit(\n            Syntax(\n                CODE,\n                lexer=\"python\",\n                line_numbers=True,\n                line_range=(2, 10),\n                theme=\"monokai\",\n                code_width=60,\n                word_wrap=True,\n                indent_guides=True,\n            ),\n            padding=0,\n        )\n        return render(syntax)\n    elif test_name == \"test_option_no_wrap\":\n        syntax = Syntax(\n            CODE,\n            lexer=\"python\",\n            line_numbers=True,\n            line_range=(2, 10),\n            code_width=60,\n            word_wrap=False,\n            background_color=\"red\",\n        )\n        return render(syntax, True) # The test calls render with True\n    elif test_name == \"test_syntax_highlight_ranges\":\n        syntax = Syntax(\n            CODE,\n            lexer=\"python\",\n            line_numbers=True,\n            word_wrap=False,\n        )\n        stylized_ranges = [\n            _SyntaxHighlightRange(\n                start=(1, 1),\n                end=(1, 2),\n                style=Style(overline=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(1, len(\"def loop_\")),\n                end=(1, len(\"def loop_first_last\")),\n                style=Style(underline=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(1, len(\"def loop_first\")),\n                end=(3, len(\"    iter_values = iter\")),\n                style=Style(bold=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(9, len(\"    for \")),\n                end=(9, len(\"    for value in\")),\n                style=Style(strike=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(6, len(\"    except \")),\n                end=(6, len(\"    except StopIteration\")),\n                style=Style(reverse=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(10, len(\"       yield first,\")),\n                end=(10, 300),\n                style=Style(bold=True),\n            ),\n            _SyntaxHighlightRange(\n                start=(1, 1),\n                end=(30, 2),\n                style=Style(bold=True),\n            ),\n        ]\n        for range_ in stylized_ranges:\n            syntax.stylize_range(range_.style, range_.start, range_.end)\n        return render(syntax, True) # The test calls render with True\n    elif test_name == \"test_background_color_override_includes_padding\":\n        syntax = Syntax(\n            \"x = 1\",\n            lexer=\"python\",\n            padding=(1, 3),\n            background_color=\"red\",\n        )\n        return render(syntax)\n    return \"\"\n\ntest_names = [\n    \"test_blank_lines\",\n    \"test_python_render\",\n    \"test_python_render_simple\",\n    \"test_python_render_simple_passing_lexer_instance\",\n    \"test_python_render_indent_guides\",\n    \"test_option_no_wrap\",\n    \"test_syntax_highlight_ranges\",\n    \"test_background_color_override_includes_padding\",\n]\n\nfor name in test_names:\n    output = generate_output_for_test(name)\n    print(f\"--- START {name} ---\n{repr(output)}\n--- END {name} ---\")\n\n","path":"generate_syntax_test_outputs.py"}}],"api":"openai-completions","provider":"openrouter","model":"google/gemini-2.5-flash","usage":{"input":2310,"output":2002,"cacheRead":143341,"cacheWrite":0,"reasoning":0,"totalTokens":147653,"cost":{"input":0.0006929999999999999,"output":0.005005000000000001,"cacheRead":0.0043002299999999995,"cacheWrite":0,"total":0.00999823,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794172666642,"responseId":"gen-1794172666-kX7p9MTbFHKhGLZscdd3","rawStopReason":"tool_calls","durationMs":897