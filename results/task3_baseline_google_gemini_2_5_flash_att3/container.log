"\n    iter_values = iter(values)\n    try:\n        previous_value = next(iter_values)\n    except StopIteration:\n        return\n    first = True\n    for value in iter_values:\n        yield first, False, previous_value\n        first = False\n        previous_value = value\n    yield first, True, previous_value'''\n\n# Helper function to render and return string\ndef render(renderable, console_options=None) -> str:\n    console = Console(\n        width=100,\n        file=io.StringIO(),\n        color_system=\"truecolor\",\n        legacy_windows=False,\n        record=True,\n    )\n    if console_options:\n        with console:\n            console.print(renderable, options=console_options)\n    else:\n        console.print(renderable)\n    return console.file.getvalue()\n\ndef generate_output_for_test(test_name: str) -> str:\n    if test_name == \"test_blank_lines\":\n        code = \"\\n\\nimport this\\n\\n\"\n        syntax = Syntax(\n            code, lexer=\"python\", theme=\"ascii_light\", code_width=30, line_numbers=True\n        )\n        return render(syntax)\n    elif test_name == \"test_python_render\":\n        syntax = Panel.fit(\n            Syntax(\n                CODE,\n                lexer=\"python\",\n                line_numbers=True,\n                line_range=(2, 10),\n                theme=\"monokai\",\n                code_width=60,\n                word_wrap=True,\n            ),\n            padding=0,\n        )\n        return render(syntax)\n    elif test_name == \"test_python_render_simple\":\n        syntax = Syntax(\n            CODE,\n            lexer=\"python\",\n            line_numbers=False,\n            theme=\"monokai\",\n            code_width=60,\n            word_wrap=False,\n        )\n        return render(syntax)\n    elif test_name == \"test_python_render_simple_passing_lexer_instance\":\n        syntax = Syntax(\n            CODE,\n            lexer=PythonLexer(),\n            line_numbers=False,\n            