diff --git a/rich/badge.py b/rich/badge.py
new file mode 100644
index 00000000..f07b5927
--- /dev/null
+++ b/rich/badge.py
@@ -0,0 +1,65 @@
+from typing import Optional
+
+from .cells import cell_len
+from .console import Console, ConsoleOptions, RenderResult
+from .measure import Measurement
+from .segment import Segment
+from .style import Style, StyleType
+from .text import Text
+
+
+class Badge:
+    """A minimal badge component.
+
+    Args:
+        text (str): The text to display in the badge.
+        style (StyleType, optional): The style for the badge's content. Defaults to "bold white on blue".
+        border_style (StyleType, optional): The style for the badge's border. Defaults to "blue".
+        pill (bool, optional): If True, use curved "pill" borders. If False, use square borders. Defaults to True.
+        icon (Optional[str], optional): An optional icon to display before the text. Defaults to None.
+    """
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        """Render the badge to the console."""
+        text = self.text
+        if self.icon:
+            text = f"{self.icon} {text}"
+
+        render_text = Text(f" {text} ", style=self.style)
+        text_segments = console.render(render_text, options)
+
+        border_style = console.get_style(self.border_style)
+        left_border, right_border = ("(", ")") if self.pill else ("[", "]")
+
+        yield Segment(left_border, border_style)
+        yield from text_segments
+        yield Segment(right_border, border_style)
+
+    def __rich_measure__(
+        self, console: Console, options: ConsoleOptions
+    ) -> Measurement:
+        """Measure the badge for layout."""
+        text = self.text
+        if self.icon:
+            text = f"{self.icon} {text}"
+        
+        # Account for borders and padding
+        width = cell_len(text) + 4
+        return Measurement(width, width)
