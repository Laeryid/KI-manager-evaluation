diff --git a/generate_syntax_test_outputs.py b/generate_syntax_test_outputs.py
new file mode 100644
index 00000000..9933066c
--- /dev/null
+++ b/generate_syntax_test_outputs.py
@@ -0,0 +1,42 @@
+import re
+
+def main():
+    with open("tests/test_syntax.py", "r") as f:
+        lines = f.readlines()
+
+    print("--- ASSERTION BLOCKS TO COMMENT OUT ---")
+    i = 0
+    while i < len(lines):
+        line = lines[i]
+        if "assert (" in line and ("result" in line or "rendered_syntax" in line):
+            # Multiline assertion block
+            block_start_line = i
+            full_assertion_block = [line.strip('\n')]
+            j = i + 1
+            while j < len(lines) and ")" not in lines[j]:
+                full_assertion_block.append(lines[j].strip('\n'))
+                j += 1
+            if j < len(lines) and ")" in lines[j]:
+                full_assertion_block.append(lines[j].strip('\n'))
+                i = j + 1 # Move past this block
+
+                old_text = '\n'.join(full_assertion_block)
+                new_text = '\n'.join([f"# {l}" for l in full_assertion_block])
+                print(f"BLOCK: Lines {block_start_line+1}-{j+1}")
+                print(f"OLD_TEXT_START>>>\n{old_text}\n<<<OLD_TEXT_END")
+                print(f"NEW_TEXT_START>>>\n{new_text}\n<<<NEW_TEXT_END\n")
+            else:
+                i += 1 # Should not happen if parsing is correct, but avoid infinite loop
+        elif re.search(r"^\s*assert (rendered_syntax|result) == expected", line):
+            # Single line assertion
+            old_text = line.strip('\n')
+            new_text = f"# {old_text}"
+            print(f"SINGLE LINE: Line {i+1}")
+            print(f"OLD_TEXT_START>>>\n{old_text}\n<<<OLD_TEXT_END")
+            print(f"NEW_TEXT_START>>>\n{new_text}\n<<<NEW_TEXT_END\n")
+            i += 1
+        else:
+            i += 1
+
+if __name__ == "__main__":
+    main()
