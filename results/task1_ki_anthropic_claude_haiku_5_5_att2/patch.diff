diff --git a/tests/test_table.py b/tests/test_table.py
index 77a75338..164bd2c7 100644
--- a/tests/test_table.py
+++ b/tests/test_table.py
@@ -406,6 +406,30 @@ def test_padding_width():
     assert output == expected
 
 
+def test_expand_flexible_column_keeps_minimum_width_when_constrained():
+    console = Console(width=35, record=True)
+    table = Table(expand=True)
+    table.add_column("Service", width=22)
+    table.add_column("Host", width=18)
+    table.add_column("Load", ratio=1)
+    table.add_row("Database Primary", "db-node-01.internal", "82%")
+    console.print(table)
+    widths = table._calculate_column_widths(console, console.options)
+    # flexible column keeps 1 char of content plus its padding
+    assert widths[2] >= 3
+    assert "┃ … ┃" in console.export_text()
+
+
+@pytest.mark.parametrize("width", [0, 1, 5, 10, 40])
+@pytest.mark.parametrize("ratio", [None, 0])
+def test_expand_empty_or_zero_ratio_tables_do_not_crash(width, ratio):
+    console = Console(width=width, record=True)
+    table = Table(expand=True)
+    table.add_column("A", ratio=ratio)
+    table.add_column("B", ratio=ratio)
+    console.print(table)
+
+
 if __name__ == "__main__":
     render = render_tables()
     print(render)
