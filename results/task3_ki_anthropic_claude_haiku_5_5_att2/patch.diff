diff --git a/rich/badge.py b/rich/badge.py
new file mode 100644
index 00000000..b6a0fc75
--- /dev/null
+++ b/rich/badge.py
@@ -0,0 +1,85 @@
+from typing import Optional, Tuple
+
+from .cells import cell_len
+from .console import Console, ConsoleOptions, RenderResult
+from .jupyter import JupyterMixin
+from .measure import Measurement
+from .style import StyleType
+from .text import Text
+
+
+class Badge(JupyterMixin):
+    """A compact, embeddable status badge rendered as a pill or square box.
+
+    Args:
+        text (str): Text displayed inside the badge.
+        style (StyleType, optional): Style of the badge content. Defaults to "bold white on blue".
+        border_style (StyleType, optional): Style of the border caps. Defaults to "blue".
+        pill (bool, optional): Use curved pill caps ``( ... )`` if True, or square caps ``[ ... ]`` if False. Defaults to True.
+        icon (str, optional): Optional icon displayed before the text, separated by a space. Defaults to None.
+    """
+
+    LEFT_PILL = "( "
+    RIGHT_PILL = " )"
+    LEFT_SQUARE = "[ "
+    RIGHT_SQUARE = " ]"
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    @property
+    def _caps(self) -> Tuple[str, str]:
+        """The (left, right) border caps, including the inner padding space."""
+        if self.pill:
+            return self.LEFT_PILL, self.RIGHT_PILL
+        return self.LEFT_SQUARE, self.RIGHT_SQUARE
+
+    @property
+    def _body(self) -> str:
+        """The content placed between the caps."""
+        if self.icon:
+            return f"{self.icon} {self.text}"
+        return self.text
+
+    def _build_text(self) -> Text:
+        """Build a fresh Text for each render pass, so rendering stays stateless."""
+        left, right = self._caps
+        return Text.assemble(
+            (left, self.border_style),
+            (self._body, self.style),
+            (right, self.border_style),
+            no_wrap=True,
+            overflow="ellipsis",
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        yield self._build_text()
+
+    def __rich_measure__(
+        self, console: Console, options: ConsoleOptions
+    ) -> Measurement:
+        left, right = self._caps
+        width = cell_len(left) + cell_len(self._body) + cell_len(right)
+        return Measurement(width, width)
+
+
+if __name__ == "__main__":  # pragma: no cover
+    from .console import Console as _Console
+
+    _console = _Console()
+    _console.print(Badge("DEPLOYED", icon="★"))
+    _console.print(Badge("SYSTEM ALERT", pill=False, style="bold white on red", border_style="red"))
diff --git a/tests/test_badge.py b/tests/test_badge.py
new file mode 100644
index 00000000..604053b2
--- /dev/null
+++ b/tests/test_badge.py
@@ -0,0 +1,50 @@
+from rich.badge import Badge
+from rich.console import Console
+from rich.measure import Measurement
+from rich.panel import Panel
+from rich.table import Table
+
+
+def _render(renderable: object, width: int = 80) -> str:
+    console = Console(width=width, color_system=None, force_terminal=False, file=None)
+    with console.capture() as capture:
+        console.print(renderable)
+    return capture.get()
+
+
+def test_pill_badge() -> None:
+    assert _render(Badge("OK")) == "( OK )\n"
+
+
+def test_square_badge() -> None:
+    assert _render(Badge("ALERT", pill=False)) == "[ ALERT ]\n"
+
+
+def test_icon() -> None:
+    assert _render(Badge("DEPLOYED", icon="★")) == "( ★ DEPLOYED )\n"
+
+
+def test_measurement_includes_caps() -> None:
+    console = Console(width=80)
+    measurement = Measurement.get(console, console.options, Badge("OK"))
+    assert measurement == Measurement(6, 6)
+    measurement = Measurement.get(
+        console, console.options, Badge("SYSTEM", pill=False, icon="★")
+    )
+    assert measurement == Measurement(12, 12)
+
+
+def test_wide_characters_measured_by_cell() -> None:
+    console = Console(width=80)
+    measurement = Measurement.get(console, console.options, Badge("字"))
+    assert measurement == Measurement(6, 6)
+
+
+def test_nested_in_table_and_panel() -> None:
+    table = Table("svc", "state")
+    table.add_row("api", Badge("OK", icon="✔"))
+    output = _render(table)
+    assert "( ✔ OK )" in output
+
+    output = _render(Panel(Badge("INFO", pill=False)))
+    assert "[ INFO ]" in output