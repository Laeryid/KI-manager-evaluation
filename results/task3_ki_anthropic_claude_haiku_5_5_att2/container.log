blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _caps(self) -> \"tuple[str, str]\":\n        \"\"\"The (left, right) border caps, including the inner padding space.\"\"\"\n        if self.pill:\n            return self.LEFT_PILL, self.RIGHT_PILL\n        return self.LEFT_SQUARE, self.RIGHT_SQUARE\n\n    @property\n    def _body(self) -> str:\n        \"\"\"The content placed between the caps.\"\"\"\n        if self.icon:\n            return f\"{self.icon} {self.text}\"\n        return self.text\n\n    def _build_text(self) -> Text:\n        \"\"\"Build a fresh Text for each render pass, so rendering stays stateless.\"\"\"\n        left, right = self._caps\n        return Text.assemble(\n            (left, Style.pick_first(self.border_style, \"blue\") and self.border_style),\n            (self._body, self.style),\n            (right, self.border_style),\n            no_wrap=True,\n            overflow=\"ellipsis\",\n        )\n\n    def __rich_console__(\n        self, console: Console, options: ConsoleOptions\n    ) -> RenderResult:\n        yield self._build_text()\n\n    def __rich_measure__(\n        self, console: Console, options: ConsoleOptions\n    ) -> Measurement:\n        left, right = self._caps\n        width = cell_len(left) + cell_len(self._body) + cell_len(right)\n        return Measurement(width, width)\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    from .console import Console as _Console\n\n    _console = _Console()\n    _console.print(Badge(\"DEPLOYED\", icon=\"★\"))\n    _console.print(Badge(\"SYSTEM ALERT\", pill=False, style=\"bold white on red\", border_style=\"red\"))\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":3850,"cacheRead":14303,"cacheWri