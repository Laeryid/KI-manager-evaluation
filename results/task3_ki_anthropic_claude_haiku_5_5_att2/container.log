apture.get()\n\n\ndef test_pill_badge() -> None:\n    assert _render(Badge(\"OK\")) == \"( OK )\\n\"\n\n\ndef test_square_badge() -> None:\n    assert _render(Badge(\"ALERT\", pill=False)) == \"[ ALERT ]\\n\"\n\n\ndef test_icon() -> None:\n    assert _render(Badge(\"DEPLOYED\", icon=\"★\")) == \"( ★ DEPLOYED )\\n\"\n\n\ndef test_measurement_includes_caps() -> None:\n    console = Console(width=80)\n    measurement = Measurement.get(console, console.options, Badge(\"OK\"))\n    assert measurement == Measurement(6, 6)\n    measurement = Measurement.get(\n        console, console.options, Badge(\"SYSTEM\", pill=False, icon=\"★\")\n    )\n    assert measurement == Measurement(12, 12)\n\n\ndef test_wide_characters_measured_by_cell() -> None:\n    console = Console(width=80)\n    measurement = Measurement.get(console, console.options, Badge(\"字\"))\n    assert measurement == Measurement(6, 6)\n\n\ndef test_nested_in_table_and_panel() -> None:\n    table = Table(\"svc\", \"state\")\n    table.add_row(\"api\", Badge(\"OK\", icon=\"✔\"))\n    output = _render(table)\n    assert \"( ✔ OK )\" in output\n\n    output = _render(Panel(Badge(\"INFO\", pill=False)))\n    assert \"[ INFO ]\" in output\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":834,"cacheRead":23803,"cacheWrite":897,"totalTokens":25536,"cost":{"input":2.0000000000000002e-7,"output":0.000417,"cacheRead":0.00023803,"cacheWrite":0.000112125,"total":0.000767355,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":90},"stopReason":"toolUse","timestamp":1794168215692,"providerThinkingLevel":"medium","responseId":"msg_011Cgr4QJk86zs7KpbP977Zi","rawStopReason":"tool_use","durationMs":4128,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"toolu_01Jimt34SqHi9cAQsSah2crX","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /app/tests/test_badge.py"}],"isError":false,"durationMs":6,"timestamp":1794168219832},{"role"