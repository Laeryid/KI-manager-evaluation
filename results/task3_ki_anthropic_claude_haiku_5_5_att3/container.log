elf.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _content(self) -> str:\n        \"\"\"str: The inner text, including the optional icon.\"\"\"\n        if self.icon:\n            return f\"{self.icon} {self.text}\"\n        return self.text\n\n    @property\n    def _caps(self) -> \"tuple[str, str]\":\n        \"\"\"tuple[str, str]: Left and right boundary caps, including inner padding.\"\"\"\n        return (\"( \", \" )\") if self.pill else (\"[ \", \" ]\")\n\n    def _width(self) -> int:\n        \"\"\"int: Total cell width of the badge, including caps and inner padding.\"\"\"\n        left, right = self._caps\n        return cell_len(left) + cell_len(self._content) + cell_len(right)\n\n    def __rich_measure__(\n        self, console: \"Console\", options: ConsoleOptions\n    ) -> Measurement:\n        width = self._width()\n        return Measurement(width, width)\n\n    def __rich_console__(\n        self, console: \"Console\", options: ConsoleOptions\n    ) -> RenderResult:\n        left, right = self._caps\n        border = console.get_style(self.border_style)\n        style = console.get_style(self.style)\n        line = [\n            Segment(left, border),\n            Segment(self._content, style),\n            Segment(right, border),\n        ]\n        width = min(self._width(), options.max_width)\n        yield from Segment.adjust_line_length(line, width)\n        yield Segment.line()\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    from .console import Console as _Console\n\n    _console = _Console()\n    _console.print(Badge(\"DEPLOYED\", icon=\"★\"))\n    _console.print(Badge(\"SYSTEM ALERT\", pill=False))\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":1222,"cacheRead":14848,"cacheWrite":3263,"totalTokens":19335,"cost":{"input":2.0000000000000002e-7,"o