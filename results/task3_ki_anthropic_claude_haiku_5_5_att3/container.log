YED )\\n\"\n\n\ndef test_measurement_matches_rendered_width() -> None:\n    console = Console(file=StringIO(), width=60, color_system=None)\n    badge = Badge(\"DEPLOYED\", icon=\"★\")\n    measurement = Measurement.get(console, console.options, badge)\n    assert measurement == Measurement(14, 14)\n\n\ndef test_badge_in_table_and_panel() -> None:\n    table = Table(\"svc\", \"status\")\n    table.add_row(\"api\", Badge(\"OK\"))\n    output = _render(table)\n    assert \"( OK )\" in output\n    assert \"( OK )\" in _render(Panel(Badge(\"OK\")))\n\n\ndef test_badge_is_cropped_to_narrow_width() -> None:\n    assert _render(Badge(\"LONGTEXT\"), width=8) == \"( LONGTE\\n\"\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":779,"cacheRead":21747,"cacheWrite":1034,"totalTokens":23562,"cost":{"input":2.0000000000000002e-7,"output":0.0003895,"cacheRead":0.00021747000000000002,"cacheWrite":0.00012925,"total":0.00073642,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":102},"stopReason":"toolUse","timestamp":1794168327232,"providerThinkingLevel":"medium","responseId":"msg_011Cgr4YVzm4axomQzX695N1","rawStopReason":"tool_use","durationMs":3387,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"toolu_01JDLowty4Cy9UXDyBPQai2S","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /app/tests/test_badge.py"}],"isError":false,"durationMs":5,"timestamp":1794168330628},{"role":"assistant","content":[{"type":"toolCall","id":"toolu_01JmoUviF31136Exubn9xx5G","name":"bash","arguments":{"command":"cd /app && python3 -m pytest tests/test_badge.py -q 2>&1 | tail -3; python3 -m pytest tests -q 2>&1 | tail -1","timeout":900}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":127,"cacheRead":22781,"cacheWrite":804,"totalTokens":23714,"cost":{"input":2.0000000000000002e-7,"output":0.0000635,"cacheRead":0.00022781,"cacheWrite