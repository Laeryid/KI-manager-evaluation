 .style import StyleType\n\n\nclass Badge:\n    \"\"\"A compact, embeddable status badge rendered as a single line.\n\n    The badge is drawn with a pill-style ``( ... )`` or square ``[ ... ]``\n    boundary. Content is padded by exactly one space inside each boundary cap.\n\n    Args:\n        text (str): Text displayed inside the badge.\n        style (StyleType, optional): Style applied to the text. Defaults to \"bold white on blue\".\n        border_style (StyleType, optional): Style applied to the boundary caps. Defaults to \"blue\".\n        pill (bool, optional): Use curved pill caps if True, square caps if False. Defaults to True.\n        icon (Optional[str], optional): Optional icon rendered before the text, separated by a space.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _content(self) -> str:\n        \"\"\"str: The inner text, including the optional icon.\"\"\"\n        if self.icon:\n            return f\"{self.icon} {self.text}\"\n        return self.text\n\n    @property\n    def _caps(self) -> \"tuple[str, str]\":\n        \"\"\"tuple[str, str]: Left and right boundary caps, including inner padding.\"\"\"\n        return (\"( \", \" )\") if self.pill else (\"[ \", \" ]\")\n\n    def _width(self) -> int:\n        \"\"\"int: Total cell width of the badge, including caps and inner padding.\"\"\"\n        left, right = self._caps\n        return cell_len(left) + cell_len(self._content) + cell_len(right)\n\n    def __rich_measure__(\n        self, console: \"Console\", options: ConsoleOptions\n    ) -> Measurement:\n        width = self._width()\n        return Measurement(width, width)\n\n    def __rich_console__(\n        self, console: \"Console\", options: ConsoleOptions\n    ) -> RenderResult:\n        left, right = self._caps\n        border = console.get_style(self.border_style)\n        style = console.get_style(self.style)\n        line = [\n            Segment(left, border),\n            Segment(self._content, style),\n            Segment(right, border),\n        ]\n        width = min(self._width(), options.max_width)\n        yield from Segment.adjust_line_length(line, width)\n        yield Segment.line()\n\n\nif __name__ == \"__main__\":  # pragma: no cover\n    from .console import Console as _Console\n\n    _console = _Console()\n    _console.print(Badge(\"DEPLOYED\", icon=\"★\"))\n    _console.print(Badge(\"SYSTEM ALERT\", pill=False))\n"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":1222,"cacheRead":14848,"cacheWrite":3263,"totalTokens":19335,"cost":{"input":2.0000000000000002e-7,"output":0.000611,"cacheRead":0.00014848000000000001,"cacheWrite":0.000407875,"total":0.001167555,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":71},"stopReason":"toolUse","timestamp":1794168289654,"providerThinkingLevel":"medium","responseId":"msg_011Cgr4Vixn2gcLrjHdQ1pn5","rawStopReason":"tool_use","durationMs":4592,"thinkingLevel":"medium"},{"role":"toolResult","toolCallId":"toolu_01L34nD3tYTFBtWBoAHkt5k4","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /app/rich/badge.py"}],"isError":false,"durationMs":7,"timestamp":1794168294258},{"role":"assistant","content":[{"type":"thinking","thinking":"I'm checking whether the `tuple[str, str]` string annotation could trip mypy for Python versions before 3.9, and I'm leaning toward switching to `Tuple` from typing to be safe. Next I'm turning to `__init__.py`: I need to add \"Badge\" to `__all__`, add a lazy `__getattr__`, and confirm that `from rich import Badge` will actually work through i