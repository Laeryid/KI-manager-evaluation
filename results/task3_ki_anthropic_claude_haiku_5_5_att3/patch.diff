+++ b/tests/test_badge.py
@@ -0,0 +1,44 @@
+from io import StringIO
+
+from rich import Badge
+from rich.console import Console
+from rich.measure import Measurement
+from rich.panel import Panel
+from rich.table import Table
+
+
+def _render(renderable, width: int = 60) -> str:
+    console = Console(file=StringIO(), width=width, color_system=None)
+    console.print(renderable)
+    return console.file.getvalue()
+
+
+def test_pill_badge() -> None:
+    assert _render(Badge("OK")) == "( OK )\n"
+
+
+def test_square_badge() -> None:
+    assert _render(Badge("ALERT", pill=False)) == "[ ALERT ]\n"
+
+
+def test_icon_badge() -> None:
+    assert _render(Badge("DEPLOYED", icon="★")) == "( ★ DEPLOYED )\n"
+
+
+def test_measurement_matches_rendered_width() -> None:
+    console = Console(file=StringIO(), width=60, color_system=None)
+    badge = Badge("DEPLOYED", icon="★")
+    measurement = Measurement.get(console, console.options, badge)
+    assert measurement == Measurement(14, 14)
+
+
+def test_badge_in_table_and_panel() -> None:
+    table = Table("svc", "status")
+    table.add_row("api", Badge("OK"))
+    output = _render(table)
+    assert "( OK )" in output
+    assert "( OK )" in _render(Panel(Badge("OK")))
+
+
+def test_badge_is_cropped_to_narrow_width() -> None:
+    assert _render(Badge("LONGTEXT"), width=8) == "( LONGTE\n"