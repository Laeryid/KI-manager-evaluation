{"type":"tool_execution_end","toolCallId":"call_hBdEp1Z8JaHZArWNZgphLSFG","toolName":"read","result":{"content":[{"type":"text","text":"\"\"\"A compact, embeddable status badge renderable.\"\"\"\n\nfrom typing import TYPE_CHECKING, Optional\n\nfrom .cells import cell_len\nfrom .measure import Measurement\nfrom .segment import Segment\nfrom .style import StyleType\n\nif TYPE_CHECKING:\n    from .console import Console, ConsoleOptions, RenderResult\n\n\nclass Badge:\n    \"\"\"A small label with a styled border.\n\n    ``Badge`` is a single-line renderable and may be used anywhere Rich accepts\n    a renderable, including tables and panels.\n\n    Args:\n        text: The text displayed in the badge.\n        style: Style applied to the badge text.\n        border_style: Style applied to the badge border.\n        pill: Use rounded (parenthesis) borders when true, or square brackets\n            when false.\n        icon: Optional icon displayed before the text.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _label(self) -> str:\n        \"\"\"Return the text displayed between the badge borders.\"\"\"\n        return f\"{self.icon} {self.text}\" if self.icon is not None else self.text\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        \"\"\"Render the badge as a stream of styled segments.\"\"\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        yield Segment(left, console.get_style(self.border_style))\n        yield Segment(\n            f\" {self._label} \", console.get_style(self.style)\n        )\n        yield Segment(right, console.get_style(self.border_style))\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        \"\"\"Return the exact number of cells occupied by the badge.\"\"\"\n        # There are two border cells and one padding cell on either side of\n        # the label. ``cell_len`` is required here rather than len(), since\n        # terminal characters may occupy more than one cell.\n        width = cell_len(self._label) + 4\n        return Measurement(width, width)\n"}],"structuredContent":"\"\"\"A compact, embeddable status badge renderable.\"\"\"\n\nfrom typing import TYPE_CHECKING, Optional\n\nfrom .cells import cell_len\nfrom .measure import Measurement\nfrom .segment import Segment\nfrom .style import StyleType\n\nif TYPE_CHECKING:\n    from .console import Console, ConsoleOptions, RenderResult\n\n\nclass Badge:\n    \"\"\"A small label with a styled border.\n\n    ``Badge`` is a single-line renderable and may be used anywhere Rich accepts\n    a renderable, including tables and panels.\n\n    Args:\n        text: The text displayed in the badge.\n        style: Style applied to the badge text.\n        border_style: Style applied to the badge border.\n        pill: Use rounded (parenthesis) borders when true, or square brackets\n            when false.\n        icon: Optional icon displayed before the text.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _label(self) -> str:\n        \"\"\"Return the text displayed between the badge borders.\"\"\"\n        return f\"{self.icon} {self.text}\" if self.icon is not None else self.text\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        \"\"\"Render the badge as a stream of styled segments.\"\"\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        yield Segment(left, console.get_style(self.border_style))\n        yield Segment(\n            f\" {self._label} \", console.get_style(self.style)\n        )\n        yield Segment(right, console.get_style(self.border_style))\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        \"\"\"Return the exact number of cells occupied by the badge.\"\"\"\n        # There are two border cells and one padding cell on either side of\n        # the label. ``cell_len`` is required here rather than len(), since\n        # terminal characters may occupy more than one cell.\n        width = cell_len(self._label) + 4\n        return Measurement(width, width)\n"},"isError":false,"durationMs":8}
