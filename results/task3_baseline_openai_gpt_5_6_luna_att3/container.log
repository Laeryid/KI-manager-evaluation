d may be used anywhere Rich accepts\n    a renderable, including tables and panels.\n\n    Args:\n        text: The text displayed in the badge.\n        style: Style applied to the badge text.\n        border_style: Style applied to the badge border.\n        pill: Use rounded (parenthesis) borders when true, or square brackets\n            when false.\n        icon: Optional icon displayed before the text.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    @property\n    def _label(self) -> str:\n        \"\"\"Return the text displayed between the badge borders.\"\"\"\n        return f\"{self.icon} {self.text}\" if self.icon is not None else self.text\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n        \"\"\"Render the badge as a stream of styled segments.\"\"\"\n        left, right = (\"(\", \")\") if self.pill else (\"[\", \"]\")\n        yield Segment(\n            f\"{left} \", console.get_style(self.border_style)\n        )\n        yield Segment(self._label, console.get_style(self.style))\n        yield Segment(f\" {right}\", console.get_style(self.border_style))\n\n    def __rich_measure__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> Measurement:\n        \"\"\"Return the exact number of cells occupied by the badge.\"\"\"\n        # There are two border cells and one padding cell on either side of\n        # the label. ``cell_len`` is required here rather than len(), since\n        # terminal characters may occupy more than one cell.\n        width = cell_len(self._label) + 4\n        return Measurement(width, width)\n"}}],"api":"openai-completions","provider":"openrouter","model":"openai/gpt-5.6-luna","usage":{"input":3,"output":1041,"cacheRead":12270,"cacheWrite":767,"reasoning":408,"totalTokens":14081,"cost":{"input":6.000000000000001e-7,"output":0.0012492,"cacheRead":0.0002454,"cacheWrite":0.00019175,"total":0.00168695,"totalFromProvider":true}},"stopReason":"toolUse","timestamp":1794170242912,"responseId":"gen-1794170243-v7btnsyDbH0L9oFK8SJp","rawStopReason":"tool_calls","durationMs":11890,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"call_CfYr8V7h0Pg70KTYVtQnooqD","toolName":"write","content":[{"type":"text","text":"Successfully wrote to /app/rich/badge.py"}],"isError":false,"durationMs":8,"timestamp":1794170254814}]}
