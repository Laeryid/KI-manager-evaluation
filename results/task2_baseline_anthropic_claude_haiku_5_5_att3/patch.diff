diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..670dc0fa 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,26 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+def test_double_underline() -> None:
+    style = Style(double_underline=True)
+    assert style.double_underline is True
+    assert style.underline is None
+    assert str(style) == "double_underline"
+    assert Style.parse("double_underline").double_underline is True
+    assert Style.parse("double-underline").double_underline is True
+    assert Style.parse("du").double_underline is True
+    assert Style.parse("not du").double_underline is False
+
+
+def test_double_underline_combine_and_ansi() -> None:
+    combined = Style(bold=True) + Style(double_underline=True)
+    assert combined.double_underline is True
+    assert combined.bold is True
+    assert Style.combine([Style(underline=True), Style(double_underline=True)]).double_underline
+    assert Style(double_underline=True).render("x", color_system=ColorSystem.TRUECOLOR) == "\x1b[21mx\x1b[0m"
+
+
+def test_double_underline_html() -> None:
+    assert Style(double_underline=True).get_html_style() == "text-decoration: underline double"