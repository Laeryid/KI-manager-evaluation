diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..52e264c0 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,18 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+@pytest.mark.parametrize("name", ["double_underline", "double-underline", "du"])
+def test_double_underline_parse(name: str) -> None:
+    style = Style.parse(name)
+    assert style.double_underline is True
+    assert style.render("x", color_system=ColorSystem.STANDARD) == "\x1b[21mx\x1b[0m"
+
+
+def test_double_underline_init_and_combine() -> None:
+    assert Style(double_underline=True).double_underline is True
+    assert Style().double_underline is None
+    assert (Style(italic=True) + Style(double_underline=True)).double_underline is True
+    assert Style.combine([Style(bold=True), Style(double_underline=True)]).double_underline
+    assert "text-decoration: underline double" in Style(double_underline=True).get_html_style()