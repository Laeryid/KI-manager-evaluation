 def _collapse_widths(\n        cls,\n        widths: List[int],\n        wrapable: List[bool],\n        max_width: int,\n        minimum_widths: Optional[List[int]] = None,\n    ) -> List[int]:\n        \"\"\"Reduce widths so that the total is under max_width.\n\n        Args:\n            widths (List[int]): List of widths.\n            wrapable (List[bool]): List of booleans that indicate if a column may shrink.\n            max_width (int): Maximum width to reduce to.\n            minimum_widths (List[int], optional): Smallest width each column may\n                shrink to. Defaults to zero for every column.\n\n        Returns:\n            List[int]: A new list of widths.\n        \"\"\"\n        if minimum_widths is None:\n            minimum_widths = [0] * len(widths)\n        total_width = sum(widths)\n        excess_width = total_width - max_width\n        if any(wrapable):\n            while total_width and excess_width > 0:\n                # Only columns above their minimum width may still shrink\n                shrinkable = [\n                    allow_wrap and width > minimum\n                    for width, allow_wrap, minimum in zip(\n                        widths, wrapable, minimum_widths\n                    )\n                ]\n                if not any(shrinkable):\n                    break\n                max_column = max(\n                    width for width, can_shrink in zip(widths, shrinkable) if can_shrink\n                )\n                second_max_column = max(\n                    width if can_shrink and width != max_column else 0\n                    for width, can_shrink in zip(widths, shrinkable)\n                )\n                column_difference = max_column - second_max_column\n                ratios = [\n                    (1 if (width == max_column and can_shrink) else 0)\n                    for width, can_shrink in zip(widths, shrinkable)\n                ]\n                if not any(ratios) or not column_differen