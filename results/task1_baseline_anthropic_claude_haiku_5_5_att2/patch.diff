diff --git a/tests/test_table.py b/tests/test_table.py
index 77a75338..4e3dece5 100644
--- a/tests/test_table.py
+++ b/tests/test_table.py
@@ -410,3 +410,31 @@ if __name__ == "__main__":
     render = render_tables()
     print(render)
     print(repr(render))
+
+
+def test_flexible_column_keeps_minimum_width_when_constrained():
+    # Fixed columns overflow the console, flexible column must stay visible
+    console = Console(width=20, file=io.StringIO())
+    table = Table(expand=True, box=None, show_header=True)
+    table.add_column("A", width=30)
+    table.add_column("Load", ratio=1)
+    table.add_row("x", "82%")
+    with console.capture() as capture:
+        console.print(table)
+    lines = capture.get().splitlines()
+    assert all(len(line.rstrip()) <= 20 for line in lines)
+    assert any("ÔÇŽ" in line or "Load" in line for line in lines)
+    # The flexible column is at least 1 cell of content plus padding wide
+    widths = table._calculate_column_widths(console, console.options)
+    assert widths[1] >= 3
+
+
+def test_expand_empty_and_zero_ratio_tables_do_not_crash():
+    for width in (0, 1, 5, 60):
+        console = Console(width=width, file=io.StringIO())
+        console.print(Table(expand=True))
+        table = Table(expand=True)
+        table.add_column("A", ratio=0)
+        table.add_column("B", ratio=0)
+        table.add_row("x", "y")
+        console.print(table)
