ame":"write","arguments":{"path":"/app/rich/badge.py","content":"from typing import TYPE_CHECKING, Optional\n\nfrom .measure import Measurement\nfrom .style import StyleType\nfrom .text import Text\n\nif TYPE_CHECKING:\n    from .console import Console, ConsoleOptions, RenderResult\n\n\nclass Badge:\n    \"\"\"A compact, inline status badge.\n\n    Renders as ``( text )`` (pill) or ``[ text ]`` (square), optionally prefixed\n    with an icon. Being a standard renderable, it can be printed directly or\n    embedded in Tables, Panels, Columns, Trees, etc.\n\n    Args:\n        text (str): The text to display in the badge.\n        style (StyleType, optional): Style applied to the badge content.\n            Defaults to \"bold white on blue\".\n        border_style (StyleType, optional): Style applied to the border characters.\n            Defaults to \"blue\".\n        pill (bool, optional): Use curved pill borders ``( )`` if True, or square\n            borders ``[ ]`` if False. Defaults to True.\n        icon (str, optional): An optional icon displayed before the text. Defaults to None.\n    \"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n        content = f\"{icon} {text}\" if icon else text\n        left, right = (\"( \", \" )\") if pill else (\"[ \", \" ]\")\n        self._text = Text.assemble(\n            (left, border_style),\n            (content, style),\n            (right, border_style),\n            no_wrap=True,\n            overflow=\"ellipsis\",\n            end=\"\",\n        )\n\n    def __rich_console__(\n        self, console: \"Console\", options: \"ConsoleOptions\"\n    ) -> \"RenderResult\":\n   