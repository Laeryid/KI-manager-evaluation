wrap\n                )\n                second_max_column = max(\n                    width if allow_wrap and width != max_column else 0\n                    for width, allow_wrap in zip(widths, wrapable)\n                )\n                column_difference = max_column - second_max_column\n                ratios = [\n                    (1 if (width == max_column and allow_wrap) else 0)\n                    for width, allow_wrap in zip(widths, wrapable)\n                ]\n                if not any(ratios) or not column_difference:\n                    break\n                max_reduce = [min(excess_width, column_difference)] * len(widths)","newText":"    def _collapse_widths(\n        cls,\n        widths: List[int],\n        wrapable: List[bool],\n        max_width: int,\n        minimum_widths: Optional[List[int]] = None,\n    ) -> List[int]:\n        \"\"\"Reduce widths so that the total is under max_width.\n\n        Args:\n            widths (List[int]): List of widths.\n            wrapable (List[bool]): List of booleans that indicate if a column may shrink.\n            max_width (int): Maximum width to reduce to.\n            minimum_widths (Optional[List[int]]): Smallest width each column may\n                shrink to. Defaults to zero for every column.\n\n        Returns:\n            List[int]: A new list of widths.\n        \"\"\"\n        if minimum_widths is None:\n            minimum_widths = [0] * len(widths)\n        total_width = sum(widths)\n        excess_width = total_width - max_width\n        if any(wrapable):\n            while total_width and excess_width > 0:\n                # Columns that may still shrink without dropping below their minimum\n                shrinkable = [\n                    allow_wrap and width > minimum\n                    for width, allow_wrap, minimum in zip(\n                        widths, wrapable, minimum_widths\n                    )\n                ]\n                if not any(shrinkable):\n                    break\n                max_column = max(\n                    width for width, can_shrink in zip(widths, shrinkable) if can_shrink\n                )\n                second_max_column = max(\n                    width if can_shrink and width != max_column else 0\n                    for width, can_shrink in zip(widths, shrinkable)\n                )\n                column_difference = max_column - second_max_column\n                ratios = [\n                    (1 if (width == max_column and can_shrink) else 0)\n                    for width, can_shrink in zip(widths, shrinkable)\n                ]\n                if not any(ratios) or not column_difference:\n                    break\n                max_reduce = [\n                    max(0, min(excess_width, column_difference, width - minimum))\n                    for width, minimum in zip(widths, minimum_widths)\n                ]"}]}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":2983,"cacheRead":32136,"cacheWrite":1144,"totalTokens":36265,"cost":{"input":2.0000000000000002e-7,"output":0.0014915,"cacheRead":0.00032136,"cacheWrite":0.000143,"total":0.00195606,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":211},"stopReason":"toolUse","timestamp":1794166986824,"providerThinkingLevel":"medium","responseId":"msg_011Cgr2qhDBc6gQLiv9viJxE","rawStopReason":"tool_use","durationMs":9682,"thinkingLevel":"medium"}}
