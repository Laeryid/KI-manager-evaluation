diff --git a/rich/badge.py b/rich/badge.py
new file mode 100644
index 00000000..279ccb9d
--- /dev/null
+++ b/rich/badge.py
@@ -0,0 +1,77 @@
+from typing import Optional
+
+from rich.console import Console, ConsoleOptions, RenderResult
+from rich.measure import Measurement
+from rich.segment import Segment
+from rich.style import StyleType, Style
+from rich.text import Text
+
+class Badge:
+    """A simple UI badge."""
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        """Render the badge to the console."""
+        content = Text(self.text, style=self.style)
+        if self.icon:
+            content = Text(f"{self.icon} ", style=self.style) + content
+
+        width = options.max_width
+        text_width = len(content.plain)
+        
+        # Calculate padding and total width
+        padding_width = 2  # One space on each side of the text
+        total_width = text_width + padding_width
+
+        # Ensure the badge doesn't exceed the console width
+        if total_width > width:
+            # If it does, truncate the text and adjust width
+            content.truncate(width - padding_width)
+            total_width = width
+            text_width = len(content.plain)
+            
+        # Determine border characters
+        if self.pill:
+            left_border = "("
+            right_border = ")"
+        else:
+            left_border = "["
+            right_border = "]"
+
+        # Create segments for the badge
+        segments = [
+            Segment(left_border, Style.parse(self.border_style)),
+            Segment(" "),
+            *content.render(console, options),
+            Segment(" "),
+            Segment(right_border, Style.parse(self.border_style)),
+        ]
+        yield from segments
+
+    def __rich_measure__(
+        self, console: Console, options: ConsoleOptions
+    ) -> Measurement:
+        """Measure the badge's width."""
+        text_width = len(self.text)
+        if self.icon:
+            text_width += len(self.icon) + 1  # +1 for the space
+
+        # Min and max width are the same, as the badge has a fixed width based on its content
+        width = text_width + 4  # 2 for borders, 2 for inner spaces
+        return Measurement(width, width)