{"type":"tool_execution_end","toolCallId":"tool_read_84btFkEYkKSXGT7dX05T","toolName":"read","result":{"content":[{"type":"text","text":"from typing import Optional\n\nfrom rich.console import Console, ConsoleOptions, RenderResult\nfrom rich.measure import Measurement\nfrom rich.segment import Segment\nfrom rich.style import StyleType, Style\nfrom rich.text import Text\n\nclass Badge:\n    \"\"\"A simple UI badge.\"\"\"\n\n    def __init__(\n        self,\n        text: str,\n        *,\n        style: StyleType = \"bold white on blue\",\n        border_style: StyleType = \"blue\",\n        pill: bool = True,\n        icon: Optional[str] = None,\n    ) -> None:\n        self.text = text\n        self.style = style\n        self.border_style = border_style\n        self.pill = pill\n        self.icon = icon\n\n    def __rich_console__(\n        self, console: Console, options: ConsoleOptions\n    ) -> RenderResult:\n        \"\"\"Render the badge to the console.\"\"\"\n        content = Text(self.text, style=self.style)\n        if self.icon:\n            content = Text(f\"{self.icon} \", style=self.style) + content\n\n        width = options.max_width\n        text_width = len(content.plain)\n        \n        # Calculate padding and total width\n        padding_width = 2  # One space on each side of the text\n        total_width = text_width + padding_width\n\n        # Ensure the badge doesn't exceed the console width\n        if total_width > width:\n            # If it does, truncate the text and adjust width\n            content.truncate(width - padding_width)\n            total_width = width\n            text_width = len(content.plain)\n            \n        # Determine border characters\n        if self.pill:\n            left_border = \"(\"\n            right_border = \")\"\n        else:\n            left_border = \"[\"\n            right_border = \"]\"\n\n        # Create segments for the badge\n        segments = [\n            Segment(left_border, Style.