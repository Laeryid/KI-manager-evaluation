diff --git a/tests/test_console.py b/tests/test_console.py
index ef829873..110f7b30 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -1127,3 +1127,12 @@ def test_tty_compatible() -> None:
     assert not console.is_terminal
     # Should not have auto-detected
     assert not console.file.called_isatty
+
+
+def test_double_underline_markup_and_svg():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", record=True
+    )
+    console.print("[double-underline red]Alert[/]")
+    assert "\x1b[21;31mAlert" in console.file.getvalue()
+    assert "text-decoration: underline double;" in console.export_svg()
diff --git a/tests/test_style.py b/tests/test_style.py
index 84a65a67..8656b64f 100644
--- a/tests/test_style.py
+++ b/tests/test_style.py
@@ -265,3 +265,19 @@ def test_clear_meta_and_links_clears_hash():
 
     clear_style = style.clear_meta_and_links()
     assert clear_style._hash is None
+
+
+def test_double_underline():
+    assert Style(double_underline=True).double_underline
+    assert Style(underline2=True).double_underline  # legacy alias
+    for name in ("double_underline", "double-underline", "du"):
+        assert Style.parse(name).double_underline
+    assert Style.parse("not du").double_underline is False
+    assert (Style(bold=True) + Style(double_underline=True)).double_underline
+    assert Style.combine(
+        [Style(double_underline=True), Style(italic=True)]
+    ).double_underline
+    assert Style(double_underline=True)._make_ansi_codes(ColorSystem.TRUECOLOR) == "21"
+    assert Style(double_underline=True).get_html_style() == (
+        "text-decoration: underline double"
+    )