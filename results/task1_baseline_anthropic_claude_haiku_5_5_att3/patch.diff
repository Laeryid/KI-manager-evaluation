+def test_flexible_column_keeps_minimum_width_when_constrained():
+    console = Console(width=50, record=True, file=io.StringIO(), legacy_windows=False)
+    table = Table(title="Worker Dashboard", expand=True)
+    table.add_column("Service", width=22)
+    table.add_column("Host", width=18)
+    table.add_column("Load", ratio=1)
+    table.add_row("Database Primary", "db-node-01.internal", "82%")
+    console.print(table)
+    lines = console.export_text().splitlines()
+    # The flexible column keeps 1 character of content plus padding
+    assert lines[2].endswith("Ôöâ ÔÇŽ Ôöâ")
+    assert lines[4].endswith("Ôöé ÔÇŽ Ôöé")
+
+
+@pytest.mark.parametrize("width", range(0, 60, 3))
+def test_expand_tables_never_raise(width):
+    console = Console(width=width, file=io.StringIO())
+    table = Table(expand=True, min_width=30)
+    table.add_column("a", ratio=0)
+    table.add_column("b", ratio=0)
+    console.print(table)
