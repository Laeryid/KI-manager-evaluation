@@ -585,6 +597,40 @@ class Table(JupyterMixin):
 
         return widths
 
+    @staticmethod
+    def _reserve_minimum_widths(
+        widths: List[int], minimums: List[int], max_width: int
+    ) -> List[int]:
+        """Raise widths to their minimums, taking the space from the widest columns.
+
+        Args:
+            widths (List[int]): List of widths.
+            minimums (List[int]): Minimum width for each column.
+            max_width (int): Maximum total width to reduce to, where possible.
+
+        Returns:
+            List[int]: A new list of widths.
+        """
+        if all(width >= minimum for width, minimum in zip(widths, minimums)):
+            return widths
+        if sum(minimums) > max_width:
+            # Minimums cannot all fit, so leave the widths alone
+            return widths
+        widths = [max(width, minimum) for width, minimum in zip(widths, minimums)]
+        excess_width = sum(widths) - max_width
+        while excess_width > 0:
+            reducible = [
+                index
+                for index, (width, minimum) in enumerate(zip(widths, minimums))
+                if width > minimum
+            ]
+            if not reducible:
+                break
+            index = max(reducible, key=lambda i: widths[i])
+            widths[index] -= 1
+            excess_width -= 1
+        return widths
+
