, minimums: List[int], max_width: int\n+    ) -> List[int]:\n+        \"\"\"Raise widths to their minimums, taking the space from the widest columns.\n+\n+        Args:\n+            widths (List[int]): List of widths.\n+            minimums (List[int]): Minimum width for each column.\n+            max_width (int): Maximum total width to reduce to, where possible.\n+\n+        Returns:\n+            List[int]: A new list of widths.\n+        \"\"\"\n+        if all(width >= minimum for width, minimum in zip(widths, minimums)):\n+            return widths\n+        if sum(minimums) > max_width:\n+            # Minimums cannot all fit, so leave the widths alone\n+            return widths\n+        widths = [max(width, minimum) for width, minimum in zip(widths, minimums)]\n+        excess_width = sum(widths) - max_width\n+        while excess_width > 0:\n+            reducible = [\n+                index\n+                for index, (width, minimum) in enumerate(zip(widths, minimums))\n+                if width > minimum\n+            ]\n+            if not reducible:\n+                break\n+            index = max(reducible, key=lambda i: widths[i])\n+            widths[index] -= 1\n+            excess_width -= 1\n+        return widths\n+\n     @classmethod\n     def _collapse_widths(\n         cls, widths: List[int], wrapable: List[bool], max_width: int\n"}],"isError":false,"durationMs":51318,"timestamp":1794166604004}]}
