:\n                kind = (flexkinds >> i) & 1\n                if kind: t.add_column(f\"c{i}\", ratio=random.choice([0,1,2]))\n                else: t.add_column(f\"c{i}\", width=random.choice([None, 5, 20]))\n            for _ in range(rows): t.add_row(*[\"value here\" if i%2 else \"x\" for i in range(ncols)])\n            try: c.print(t)\n            except Exception as e: note(\"render\", e); errs.setdefault(\"ex\", traceback.format_exc()[-400:])\n            try: Console(width=w, file=io.StringIO()).print(Table.grid()) \n            except Exception as e: note(\"grid\", e)\nprint(errs or \"no errors\")\nEOF\npython3 /tmp/fuzz.py"}}}}
