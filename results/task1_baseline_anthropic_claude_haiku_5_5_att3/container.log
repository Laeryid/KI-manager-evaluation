e(expand=True, min_width=30)\n    table.add_column(\"a\", ratio=0)\n    table.add_column(\"b\", ratio=0)\n    console.print(table)\n    console.print(Table(expand=True).add_column(\"c\", ratio=1) or Table())''','''def test_expand_tables_never_raise(width):\n    console = Console(width=width, file=io.StringIO())\n    table = Table(expand=True, min_width=30)\n    table.add_column(\"a\", ratio=0)\n    table.add_column(\"b\", ratio=0)\n    console.print(table)''')\nopen(p,'w').write(s)\np='tests/test_tools.py'\ns=open(p).read().replace(\"assert ratio_distribute(-4, [1, 1]) == [-2, -2]\",\"assert ratio_distribute(-4, [1, 1]) == [0, 0]\")\nopen(p,'w').write(s)\nEOF\ngrep -n \"record=True\" tests/test_table.py | tail -2; export PYTHONPATH=/app; python3 -m pytest tests/test_table.py tests/test_tools.py tests/test_ratio.py -q 2>&1 | tail -3"}}],"api":"anthropic-messages","provider":"openrouter","model":"anthropic/claude-haiku-5.5","usage":{"input":2,"output":1193,"cacheRead":49524,"cacheWrite":573,"totalTokens":51292,"cost":{"input":2.0000000000000002e-7,"output":0.0005965,"cacheRead":0.00049524,"cacheWrite":0.000071625,"total":0.001163565,"totalFromProvider":true},"cacheWrite1h":0,"reasoning":385},"stopReason":"toolUse","timestamp":1794166460943,"providerThinkingLevel":"medium","responseId":"msg_011Cgr2AwbHr9U3xTcNkh1hZ","rawStopReason":"tool_use","durationMs":5259,"thinkingLevel":"medium"},"toolResults":[{"role":"toolResult","toolCallId":"toolu_01RsYakgoxLZyEjnyZUaKAfC","toolName":"bash","content":[{"type":"text","text":"400:    console = Console(record=True)\n416:    console = Console(width=60, record=True, file=io.StringIO(), legacy_windows=False)\n......................................................                   [100%]\n54 passed in 1.83s\n"}],"isError":false,"durationMs":2293,"timestamp":1794166468498}]}
