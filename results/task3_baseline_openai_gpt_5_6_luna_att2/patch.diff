+"""A compact, embeddable status badge renderable."""
+
+from typing import TYPE_CHECKING, Optional
+
+from .cells import cell_len
+from .measure import Measurement
+from .style import StyleType
+
+if TYPE_CHECKING:
+    from .console import Console, ConsoleOptions, RenderResult
+
+
+class Badge:
+    """A small status badge that can be rendered in any Rich container.
+
+    Args:
+        text: The text displayed by the badge.
+        style: The style applied to the badge contents, including its padding.
+        border_style: The style applied to the badge's border characters.
+        pill: Use rounded ``( )`` borders when true, or square ``[ ]`` borders.
+        icon: An optional icon displayed before ``text``.
+    """
+
+    def __init__(
+        self,
+        text: str,
+        *,
+        style: StyleType = "bold white on blue",
+        border_style: StyleType = "blue",
+        pill: bool = True,
+        icon: Optional[str] = None,
+    ) -> None:
+        self.text = text
+        self.style = style
+        self.border_style = border_style
+        self.pill = pill
+        self.icon = icon
+
+    def __rich_console__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> "RenderResult":
+        from .text import Text
+
+        label = self.text if self.icon is None else f"{self.icon} {self.text}"
+        left, right = ("( ", " )") if self.pill else ("[ ", " ]")
+
+        # A Text renderable preserves the separate styles while remaining a
+        # normal child renderable for tables, panels, columns, and trees.
+        badge = Text.assemble(
+            (left, self.border_style),
+            (label, self.style),
+            (right, self.border_style),
+            no_wrap=True,
+            end="",
+        )
+        yield badge
+
+    def __rich_measure__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> Measurement:
+        label = self.text if self.icon is None else f"{self.icon} {self.text}"
+        left, right = ("( ", " )") if self.pill else ("[ ", " ]")
+        width = cell_len(left) + cell_len(label) + cell_len(right)
+        return Measurement(width, width)